-        void DrainCapture(
-            SystemAudioCapture& capture,
-            const AudioProgramSourceRole role) noexcept
-        {
-            AudioCapturePacket packet{};
-            while (capture.TryPop(packet))
-            {
-                const auto available = role == AudioProgramSourceRole::System
-                    ? systemAvailable
-                    : microphoneAvailable;
-                if (available)
-                {
-                    (void)core.Push(role, std::move(packet));
-                }
-                packet = {};
-            }
-        }
-
-        void ApplyCorrection() noexcept
-        {
-            const auto mix = core.Diagnostics();
-            if (mix.system.drift.clockUnhealthy)
-            {
-                systemAvailable = false;
-                core.SetSourceAvailable(
-                    AudioProgramSourceRole::System, false);
-            }
-            if (mix.microphone.drift.clockUnhealthy)
-            {
-                microphoneAvailable = false;
-                core.SetSourceAvailable(
-                    AudioProgramSourceRole::Microphone, false);
-            }
-            if (systemAvailable)
-            {
-                const auto result = systemCapture.SetRateCorrectionPpm(
-                    core.RequestedRateCorrectionPpm(
-                        AudioProgramSourceRole::System));
-                if (FAILED(result))
-                {
-                    systemAvailable = false;
-                    core.SetSourceAvailable(
-                        AudioProgramSourceRole::System, false);
-                }
-            }
-            if (microphoneAvailable)
-            {
-                const auto result = microphoneCapture.SetRateCorrectionPpm(
-                    core.RequestedRateCorrectionPpm(
-                        AudioProgramSourceRole::Microphone));
-                if (FAILED(result))
-                {
-                    microphoneAvailable = false;
-                    core.SetSourceAvailable(
-                        AudioProgramSourceRole::Microphone, false);
-                }
-            }
-        }
-
-        void DetectRuntimeSourceFailure() noexcept
-        {
-            if (sourcesStopping.load())
-            {
-                return;
-            }
-            if (systemAvailable && !systemCapture.Running())
-            {
-                const auto capture = systemCapture.Diagnostics();
-                if (FAILED(capture.terminalHResult))
-                {
-                    systemAvailable = false;
-                    core.SetSourceAvailable(
-                        AudioProgramSourceRole::System, false);
-                }
-            }
-            if (microphoneAvailable && !microphoneCapture.Running())
-            {
-                const auto capture = microphoneCapture.Diagnostics();
-                if (FAILED(capture.terminalHResult))
-                {
-                    microphoneAvailable = false;
-                    core.SetSourceAvailable(
-                        AudioProgramSourceRole::Microphone, false);
-                }
-            }
-        }
-
-        void ThreadMain() noexcept
-        {
-            {
-                std::lock_guard lock(mutex);
-                diagnostics.workerStarted = true;
-            }
-            for (;;)
-            {
-                std::int64_t target{};
-                bool applyOrigin{};
-                bool seal{};
-                bool abort{};
-                AudioProgramControls controls{};
-                {
-                    std::unique_lock lock(mutex);
-                    condition.wait_for(lock, std::chrono::milliseconds(10),
-                        [this]
-                        {
-                            return originPending || sealRequested ||
-                                abortRequested ||
-                                desiredControls.revision !=
-                                    appliedControlRevision;
-                        });
-                    applyOrigin = originPending && !originApplied;
-                    if (applyOrigin)
-                    {
-                        originPending = false;
-                        originApplied = true;
-                    }
-                    target = targetQpc100ns;
-                    seal = sealRequested;
-                    abort = abortRequested;
-                    controls = desiredControls;
-                }
-                if (abort)
-                {
-                    break;
-                }
-                if (applyOrigin)
-                {
-                    const auto system = systemCapture.Diagnostics();
-                    const auto microphone = microphoneCapture.Diagnostics();
-                    core.Start(
-                        originQpc100ns,
-                        programSource,
-                        systemAvailable,
-                        microphoneAvailable,
-                        system.devicePositionFrequency,
-                        microphone.timelinePositionFrequency);
-                    core.SetControls(controls);
-                    appliedControlRevision = controls.revision;
-                }
-                if (originApplied)
-                {
-                    if (controls.revision != appliedControlRevision)
-                    {
-                        core.SetControls(controls);
-                        appliedControlRevision = controls.revision;
-                    }
-                    DrainCapture(
-                        systemCapture, AudioProgramSourceRole::System);
-                    DrainCapture(
-                        microphoneCapture,
-                        AudioProgramSourceRole::Microphone);
-                    DetectRuntimeSourceFailure();
-                    const auto mixBeforeProduce = core.Diagnostics();
-                    std::uint64_t queuedFrames{};
-                    {
-                        std::lock_guard lock(mutex);
-                        queuedFrames = diagnostics.outputQueueFramesCurrent;
-                    }
-                    const auto availableOutputFrames = queuedFrames <
-                        MaximumOutputQueueFrames
-                        ? MaximumOutputQueueFrames - queuedFrames
-                        : 0;
-                    const auto boundedTarget = originQpc100ns +
-                        AudioTimeline::FrameToMediaTime100ns(
-                            mixBeforeProduce.outputFrames +
-                            availableOutputFrames);
-                    if (seal && target > boundedTarget)
-                    {
-                        std::lock_guard lock(mutex);
-                        diagnostics.terminalHResult =
-                            HRESULT_FROM_WIN32(ERROR_BUFFER_OVERFLOW);
-                        diagnostics.outputQueueFramesDroppedPressure +=
-                            static_cast<std::uint64_t>(AudioTimeline::DeltaToFrame(
-                                target - boundedTarget));
-                        abortRequested = true;
-                        break;
-                    }
-                    const auto productionTarget = (std::min)(
-                        target, boundedTarget);
-                    const auto result = core.ProduceUntil(
-                        productionTarget,
-                        [this](AudioProgramPcmBlock block)
-                        {
-                            EnqueueOutput(std::move(block));
-                            return S_OK;
-                        });
-                    if (FAILED(result))
-                    {
-                        std::lock_guard lock(mutex);
-                        diagnostics.terminalHResult = result;
-                        abortRequested = true;
-                        break;
-                    }
-                    ApplyCorrection();
-                    {
-                        std::lock_guard lock(mutex);
-                        diagnostics.mix = core.Diagnostics();
-                        diagnostics.degradedToSingleSource =
-                            diagnostics.dualRequested &&
-                            (diagnostics.mix.system.degraded ||
-                             diagnostics.mix.microphone.degraded);
-                    }
-                }
-                if (seal)
-                {
-                    core.Seal();
-                    std::lock_guard lock(mutex);
-                    diagnostics.mix = core.Diagnostics();
-                    break;
-                }
-            }
-            RefreshCaptureDiagnostics();
-            std::lock_guard lock(mutex);
-            diagnostics.workerExited = true;
-        }
-    };
