diff --git a/XbPreview.Host/SoundFlowAudioCore.cs b/XbPreview.Host/SoundFlowAudioCore.cs
new file mode 100644
index 0000000..8972c4f
--- /dev/null
+++ b/XbPreview.Host/SoundFlowAudioCore.cs
@@ -0,0 +1,518 @@
+using System.Buffers;
+using System.Reflection;
+using System.Text.Json;
+using SoundFlow.Abstracts;
+using SoundFlow.Abstracts.Devices;
+using SoundFlow.Backends.MiniAudio;
+using SoundFlow.Backends.MiniAudio.Devices;
+using SoundFlow.Backends.MiniAudio.Enums;
+using SoundFlow.Components;
+using SoundFlow.Enums;
+using SoundFlow.Extensions.WebRtc.Apm.Modifiers;
+using SoundFlow.Interfaces;
+using SoundFlow.Providers;
+using SoundFlow.Structs;
+
+namespace XbPreview.Host;
+
+internal static class MicrophoneAvailabilityContract
+{
+    internal const string ErrorCode = "MicUnavailableAtStart";
+    internal const string UserMessage =
+        "麦克风已开启，但当前没有检测到可用麦克风。";
+}
+
+internal sealed class MicrophoneUnavailableAtStartException : Exception
+{
+    internal MicrophoneUnavailableAtStartException()
+        : base(MicrophoneAvailabilityContract.UserMessage)
+    {
+    }
+
+    internal MicrophoneUnavailableAtStartException(Exception innerException)
+        : base(MicrophoneAvailabilityContract.UserMessage, innerException)
+    {
+    }
+}
+
+internal sealed record AudioCoreConfiguration(
+    bool CaptureSystemAudio,
+    bool CaptureMicrophone)
+{
+    internal static AudioCoreConfiguration From(
+        NativeMethods.AudioProgramMode mode) => mode switch
+        {
+            NativeMethods.AudioProgramMode.SystemOnly => new(true, false),
+            NativeMethods.AudioProgramMode.MicrophoneOnly => new(false, true),
+            NativeMethods.AudioProgramMode.Dual => new(true, true),
+            _ => new(false, false),
+        };
+
+    internal bool Enabled => CaptureSystemAudio || CaptureMicrophone;
+
+    internal string Mode => (CaptureSystemAudio, CaptureMicrophone) switch
+    {
+        (true, true) => "Dual",
+        (true, false) => "SystemOnly",
+        (false, true) => "MicrophoneOnly",
+        _ => "None",
+    };
+}
+
+internal interface IAudioCoreFactory
+{
+    IAudioCoreSession Create(AudioCoreConfiguration configuration);
+}
+
+internal interface IAudioCoreSession : IDisposable
+{
+    AudioCoreConfiguration Configuration { get; }
+
+    string ProgramPath { get; }
+
+    void Start(string sidecarDirectory);
+
+    void Stop();
+}
+
+internal sealed class SoundFlowAudioCoreFactory : IAudioCoreFactory
+{
+    internal static SoundFlowAudioCoreFactory Instance { get; } = new();
+
+    private SoundFlowAudioCoreFactory()
+    {
+    }
+
+    public IAudioCoreSession Create(AudioCoreConfiguration configuration) =>
+        new SoundFlowAudioCoreSession(configuration);
+}
+
+internal sealed class SoundFlowAudioCoreSession : IAudioCoreSession
+{
+    internal const string ProgramFileName = "program.flac";
+    internal const int SampleRate = 48_000;
+    internal const int Channels = 2;
+    private const int ProviderBufferSamples = SampleRate * Channels * 2;
+
+    private static readonly AudioFormat ProgramFormat = new()
+    {
+        Format = SampleFormat.F32,
+        Channels = Channels,
+        Layout = ChannelLayout.Stereo,
+        SampleRate = SampleRate,
+    };
+
+    private readonly object _gate = new();
+    private readonly MiniAudioEngine _captureEngine;
+    private readonly MiniAudioEngine _mixEngine;
+    private readonly AudioPlaybackDevice? _mixDevice;
+    private readonly AudioCaptureDevice? _systemDevice;
+    private readonly AudioCaptureDevice? _microphoneDevice;
+    private readonly MicrophoneDataProvider? _systemProvider;
+    private readonly MicrophoneDataProvider? _microphoneProvider;
+    private readonly SoundPlayer? _systemPlayer;
+    private readonly SoundPlayer? _microphonePlayer;
+    private readonly WebRtcApmModifier? _microphoneApm;
+    private FileStream? _programStream;
+    private ISoundEncoder? _programEncoder;
+    private EncoderAnalyzer? _encoderAnalyzer;
+    private string? _sidecarDirectory;
+    private string? _terminalError;
+    private bool _started;
+    private bool _stopped;
+    private bool _disposed;
+
+    internal SoundFlowAudioCoreSession(AudioCoreConfiguration configuration)
+    {
+        ArgumentNullException.ThrowIfNull(configuration);
+        if (!configuration.Enabled)
+        {
+            throw new ArgumentException(
+                "AudioCore cannot create a capture session for None mode.",
+                nameof(configuration));
+        }
+
+        Configuration = configuration;
+        _captureEngine = new MiniAudioEngine([MiniAudioBackend.Wasapi]);
+        _mixEngine = new MiniAudioEngine([MiniAudioBackend.Null]);
+        _mixEngine.RegisterCodecFactory(new MiniAudioCodecFactory());
+        try
+        {
+            _captureEngine.UpdateAudioDevicesInfo();
+            if (configuration.CaptureMicrophone)
+            {
+                DeviceInfo? microphone = ResolveDefaultMicrophone();
+                if (microphone is null)
+                {
+                    throw new MicrophoneUnavailableAtStartException();
+                }
+                try
+                {
+                    _microphoneDevice = _captureEngine.InitializeCaptureDevice(
+                        microphone,
+                        ProgramFormat,
+                        new MiniAudioDeviceConfig());
+                }
+                catch (Exception error)
+                {
+                    throw new MicrophoneUnavailableAtStartException(error);
+                }
+            }
+            if (configuration.CaptureSystemAudio)
+            {
+                if (!_captureEngine.PlaybackDevices.Any())
+                {
+                    throw new InvalidOperationException(
+                        "SystemAudioUnavailableAtStart: no playback endpoint is available.");
+                }
+                _systemDevice = _captureEngine.InitializeLoopbackDevice(
+                    ProgramFormat);
+            }
+
+            _mixDevice = _mixEngine.InitializePlaybackDevice(
+                null,
+                ProgramFormat,
+                new MiniAudioDeviceConfig());
+
+            if (_systemDevice is not null)
+            {
+                _systemProvider = new MicrophoneDataProvider(
+                    _systemDevice,
+                    ProviderBufferSamples);
+                _systemPlayer = new SoundPlayer(
+                    _mixEngine,
+                    ProgramFormat,
+                    _systemProvider);
+                _mixDevice!.MasterMixer.AddComponent(_systemPlayer);
+            }
+            if (_microphoneDevice is not null)
+            {
+                _microphoneProvider = new MicrophoneDataProvider(
+                    _microphoneDevice,
+                    ProviderBufferSamples);
+                _microphonePlayer = new SoundPlayer(
+                    _mixEngine,
+                    ProgramFormat,
+                    _microphoneProvider);
+                _microphoneApm = new WebRtcApmModifier(_microphoneDevice);
+                _microphoneApm.NoiseSuppression.Enabled = true;
+                _microphoneApm.HighPassFilterEnabled = true;
+                _microphoneApm.EchoCancellation.Enabled = false;
+                _microphoneApm.AutomaticGainControl.Agc1Enabled = false;
+                _microphoneApm.AutomaticGainControl.Agc2Enabled = false;
+                _microphoneApm.PreAmplifierEnabled = false;
+                _microphonePlayer.AddModifier(_microphoneApm);
+                _mixDevice!.MasterMixer.AddComponent(_microphonePlayer);
+            }
+        }
+        catch
+        {
+            Dispose();
+            throw;
+        }
+    }
+
+    public AudioCoreConfiguration Configuration { get; }
+
+    public string ProgramPath { get; private set; } = string.Empty;
+
+    public void Start(string sidecarDirectory)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(sidecarDirectory);
+        lock (_gate)
+        {
+            ObjectDisposedException.ThrowIf(_disposed, this);
+            if (_started)
+            {
+                throw new InvalidOperationException(
+                    "The SoundFlow AudioCore session is already started.");
+            }
+            if (!Path.IsPathFullyQualified(sidecarDirectory) ||
+                !Directory.Exists(sidecarDirectory))
+            {
+                throw new DirectoryNotFoundException(sidecarDirectory);
+            }
+
+            ProgramPath = Path.Combine(sidecarDirectory, ProgramFileName);
+            if (File.Exists(ProgramPath))
+            {
+                throw new IOException(
+                    $"AudioCore output already exists: {ProgramPath}");
+            }
+            _sidecarDirectory = sidecarDirectory;
+            _programStream = new FileStream(
+                ProgramPath,
+                FileMode.CreateNew,
+                FileAccess.Write,
+                FileShare.Read,
+                64 * 1024,
+                FileOptions.SequentialScan);
+            _programEncoder = _mixEngine.CreateEncoder(
+                _programStream,
+                "flac",
+                ProgramFormat);
+            _encoderAnalyzer = new EncoderAnalyzer(
+                ProgramFormat,
+                _programEncoder);
+            _mixDevice!.MasterMixer.AddAnalyzer(_encoderAnalyzer);
+            _started = true;
+        }
+
+        try
+        {
+            _systemProvider?.StartCapture();
+            _microphoneProvider?.StartCapture();
+            _systemPlayer?.Play();
+            _microphonePlayer?.Play();
+            _mixDevice!.Start();
+            WriteMetadata(stopped: false);
+        }
+        catch
+        {
+            Stop();
+            throw;
+        }
+    }
+
+    public void Stop()
+    {
+        lock (_gate)
+        {
+            if (_stopped)
+            {
+                return;
+            }
+            _stopped = true;
+        }
+
+        TryStop(() => _mixDevice?.Stop());
+        TryStop(() => _systemPlayer?.Stop());
+        TryStop(() => _microphonePlayer?.Stop());
+        TryStop(() => _systemProvider?.StopCapture());
+        TryStop(() => _microphoneProvider?.StopCapture());
+
+        lock (_gate)
+        {
+            if (_encoderAnalyzer is not null)
+            {
+                _mixDevice?.MasterMixer.RemoveAnalyzer(_encoderAnalyzer);
+                _encoderAnalyzer = null;
+            }
+            try
+            {
+                _programEncoder?.Dispose();
+            }
+            catch (Exception error)
+            {
+                _terminalError ??= error.Message;
+            }
+            _programEncoder = null;
+            try
+            {
+                _programStream?.Dispose();
+            }
+            catch (Exception error)
+            {
+                _terminalError ??= error.Message;
+            }
+            _programStream = null;
+        }
+        WriteMetadata(stopped: true);
+    }
+
+    public void Dispose()
+    {
+        lock (_gate)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+        }
+
+        Stop();
+        TryStop(() =>
+        {
+            if (_systemPlayer is not null)
+            {
+                _mixDevice?.MasterMixer.RemoveComponent(_systemPlayer);
+            }
+        });
+        TryStop(() =>
+        {
+            if (_microphonePlayer is not null)
+            {
+                _mixDevice?.MasterMixer.RemoveComponent(_microphonePlayer);
+            }
+        });
+        TryStop(() => _systemPlayer?.Dispose());
+        TryStop(() => _microphonePlayer?.Dispose());
+        TryStop(() => _systemProvider?.Dispose());
+        TryStop(() => _microphoneProvider?.Dispose());
+        TryStop(() => _systemDevice?.Dispose());
+        TryStop(() => _microphoneDevice?.Dispose());
+        TryStop(() => _mixDevice?.Dispose());
+        TryStop(_captureEngine.Dispose);
+        TryStop(_mixEngine.Dispose);
+
+        lock (_gate)
+        {
+            _disposed = true;
+        }
+    }
+
+    private DeviceInfo? ResolveDefaultMicrophone()
+    {
+        DeviceInfo[] devices = _captureEngine.CaptureDevices;
+        if (devices.Length == 0)
+        {
+            return null;
+        }
+        foreach (DeviceInfo device in devices)
+        {
+            if (device.IsDefault && device.Id != IntPtr.Zero)
+            {
+                return device;
+            }
+        }
+        DeviceInfo fallback = devices.FirstOrDefault(
+            device => device.Id != IntPtr.Zero);
+        return fallback.Id == IntPtr.Zero ? null : fallback;
+    }
+
+    private void TryStop(Action action)
+    {
+        try
+        {
+            action();
+        }
+        catch (Exception error)
+        {
+            lock (_gate)
+            {
+                _terminalError ??= error.Message;
+            }
+        }
+    }
+
+    private void WriteMetadata(bool stopped)
+    {
+        string? directory;
+        string? terminalError;
+        lock (_gate)
+        {
+            directory = _sidecarDirectory;
+            terminalError = _terminalError;
+        }
+        if (string.IsNullOrWhiteSpace(directory))
+        {
+            return;
+        }
+
+        try
+        {
+            var facts = new
+            {
+                implementation = "SoundFlow/MiniAudio",
+                soundFlowVersion = PackageVersion(typeof(MiniAudioEngine)),
+                webRtcApmVersion = PackageVersion(typeof(WebRtcApmModifier)),
+                mode = Configuration.Mode,
+                sampleRate = SampleRate,
+                channels = Channels,
+                systemEndpointId = DeviceId(_systemDevice),
+                systemEndpointName = DeviceName(_systemDevice),
+                microphoneEndpointId = DeviceId(_microphoneDevice),
+                microphoneEndpointName = DeviceName(_microphoneDevice),
+                webRtcNoiseSuppression = _microphoneApm is not null,
+                webRtcHighPassFilter = _microphoneApm is not null,
+                webRtcAgc = false,
+                programFile = Path.GetFileName(ProgramPath),
+                programBytes = File.Exists(ProgramPath)
+                    ? new FileInfo(ProgramPath).Length
+                    : 0,
+                stopped,
+                terminalError,
+            };
+            File.WriteAllText(
+                Path.Combine(directory, "audio-core.json"),
+                JsonSerializer.Serialize(
+                    facts,
+                    new JsonSerializerOptions { WriteIndented = true }));
+        }
+        catch
+        {
+            // Evidence cannot become the owner of capture or Stop success.
+        }
+    }
+
+    private static string? PackageVersion(Type type) =>
+        type.Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
+            .InformationalVersion ??
+        type.Assembly.GetName().Version?.ToString();
+
+    private static string? DeviceId(AudioDevice? device) =>
+        device?.Info is DeviceInfo info ? info.Id.ToString() : null;
+
+    private static string? DeviceName(AudioDevice? device) =>
+        device?.Info is DeviceInfo info ? info.Name : null;
+
+    private sealed class EncoderAnalyzer : AudioAnalyzer
+    {
+        private readonly ISoundEncoder _encoder;
+
+        internal EncoderAnalyzer(AudioFormat format, ISoundEncoder encoder)
+            : base(format, NullVisualizer.Instance)
+        {
+            _encoder = encoder;
+            Name = "AudioCoreProgramEncoder";
+        }
+
+        protected override void Analyze(
+            ReadOnlySpan<float> buffer,
+            int channels)
+        {
+            _ = channels;
+            float[] rented = ArrayPool<float>.Shared.Rent(buffer.Length);
+            try
+            {
+                buffer.CopyTo(rented);
+                _encoder.Encode(rented.AsSpan(0, buffer.Length));
+            }
+            finally
+            {
+                ArrayPool<float>.Shared.Return(rented);
+            }
+        }
+    }
+
+    private sealed class NullVisualizer : IVisualizer
+    {
+        internal static NullVisualizer Instance { get; } = new();
+
+        private NullVisualizer()
+        {
+        }
+
+        public string Name => "AudioCoreNullVisualizer";
+
+        public event EventHandler? VisualizationUpdated
+        {
+            add { }
+            remove { }
+        }
+
+        public void ProcessOnAudioData(ReadOnlySpan<float> audioData)
+        {
+            _ = audioData;
+        }
+
+        public void Render(IVisualizationContext context)
+        {
+            _ = context;
+        }
+
+        public void Dispose()
+        {
+        }
+    }
+}
