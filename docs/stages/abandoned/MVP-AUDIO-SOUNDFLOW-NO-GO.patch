-    void MicNoiseDiagnosticTapBegin(
-        const WAVEFORMATEX& negotiatedFormat,
-        const MicNoiseDiagnosticCaptureFacts& captureFacts) noexcept
-    {
-        (void)negotiatedFormat;
-        std::lock_guard lifecycleLock(lifecycleMutex);
-        state.enabled.store(false, std::memory_order_release);
-        std::lock_guard dataLock(dataMutex);
-        ResetStateLocked();
-        try
-        {
-            const auto directory = ReadEnvironment(DiagnosticDirectoryVariable);
-            const auto attributes = directory.empty()
-                ? INVALID_FILE_ATTRIBUTES
-                : GetFileAttributesW(directory.c_str());
-            if (attributes == INVALID_FILE_ATTRIBUTES ||
-                (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0)
-            {
-                return;
-            }
-            state.directory = directory;
-            state.captureSource = captureFacts.captureSource != nullptr
-                ? captureFacts.captureSource : "unknown";
-            state.diagnosticTapInstance =
-                nextDiagnosticTapInstance.fetch_add(
-                    1, std::memory_order_relaxed) + 1;
-            if (pendingEncoderBinding)
-            {
-                state.diagnosticRunToken = pendingDiagnosticRunToken;
-                state.recordingSessionId = pendingEncoderSessionId;
-                state.plannedFinalPath = pendingEncoderPlannedFinalPath;
-                state.encoderGeneration = pendingEncoderGeneration;
-                state.encoderBound = true;
-                state.sessionBindingWriteHResult =
-                    pendingSessionBindingWriteHResult;
-            }
-            state.windowSeconds = ReadWindowSeconds();
-            state.windowFrames = static_cast<std::uint64_t>(
-                state.windowSeconds) * AudioOutputSampleRate;
-            const auto sampleCount = static_cast<std::size_t>(
-                state.windowFrames) * AudioOutputChannels;
-            state.postConvert.pcm.assign(sampleCount, 0);
-            state.aacWriterInput.pcm.assign(sampleCount, 0);
-            state.mp4Decoded.pcm.assign(sampleCount, 0);
-            state.enabled.store(true, std::memory_order_release);
-        }
