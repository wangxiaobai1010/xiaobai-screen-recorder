-
-        DriftResult SimulateClock(const std::int32_t sourcePpm)
-        {
-            constexpr std::int64_t origin = 9'200'000'000;
-            constexpr std::uint32_t blocks = 337'500;
-            AudioDriftController controller;
-            controller.Reset(AudioOutputSampleRate);
-            DriftResult result{};
-            for (std::uint32_t block = 0; block <= blocks; ++block)
-            {
-                const auto elapsedFrames = static_cast<std::uint64_t>(block) *
-                    AudioAacFramesPerSample;
-                const auto nominalTime = AudioTimeline::FrameToMediaTime100ns(
-                    elapsedFrames);
-                const auto jitter = static_cast<std::int64_t>(
-                    static_cast<int>(block % 5) - 2) * 10'000;
-                const auto devicePosition = static_cast<std::uint64_t>(
-                    std::llround(static_cast<double>(elapsedFrames) *
-                        (1.0 + static_cast<double>(sourcePpm) /
-                            1'000'000.0)));
-                controller.Observe(
-                    devicePosition,
-                    origin + nominalTime + jitter,
-                    controller.RequestedPpm(),
-                    false);
-                const auto requested = controller.AdvanceOutputBlock();
-                result.correctionObserved = result.correctionObserved ||
-                    requested != 0;
-                const auto diagnostics = controller.Diagnostics();
-                result.maximumPhaseFrames = (std::max)(
-                    result.maximumPhaseFrames,
-                    std::abs(diagnostics.correctedPhaseFrames));
-            }
-            const auto diagnostics = controller.Diagnostics();
-            result.requestedPpm = diagnostics.requestedPpm;
-            result.measuredPpm = diagnostics.measuredPpm;
-            result.healthy = !diagnostics.clockUnhealthy;
-            return result;
-        }
