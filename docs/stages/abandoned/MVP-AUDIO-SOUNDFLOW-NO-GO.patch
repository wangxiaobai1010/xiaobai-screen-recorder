-        const char* StatusLocked() noexcept
-        {
-            if (!state.encoderBound || state.encoderBindingConflict ||
-                state.writerFramesBeforeEncoderBinding != 0 ||
-                (!state.diagnosticRunToken.empty() &&
-                 FAILED(state.sessionBindingWriteHResult)))
-            {
-                return "ENCODER-BINDING-FAILED";
-            }
-            if (state.decodeCompleted && FAILED(state.decodeHResult))
-            {
-                return "MP4-DECODE-FAILED";
-            }
-            if (!state.anchorSet)
-            {
-                if (state.decodeCompleted &&
-                    state.mp4Audio.nonzeroFrameCount != 0)
-                {
-                    return "SESSION-AUDIO-CONTRADICTION";
-                }
-                return "NO-ACTIVE-WINDOW";
-            }
-            if (!state.flushed)
-            {
-                return "CAPTURING";
-            }
-            if (FAILED(state.postConvert.writeHResult) ||
-                FAILED(state.aacWriterInput.writeHResult))
-            {
-                return "ARTIFACT-WRITE-FAILED";
-            }
-            if (!state.decodeCompleted)
-            {
-                return "PENDING-MP4-DECODE";
-            }
-            if (FAILED(state.decodeHResult))
-            {
-                return "MP4-DECODE-FAILED";
-            }
-            if (FAILED(state.mp4Decoded.writeHResult))
-            {
-                return "ARTIFACT-WRITE-FAILED";
-            }
-            const auto post = Statistics(state.postConvert);
-            const auto writer = Statistics(state.aacWriterInput);
-            const auto decoded = Statistics(state.mp4Decoded);
-            if (post.nonzeroFrames == 0 || writer.nonzeroFrames == 0 ||
-                decoded.nonzeroFrames == 0)
-            {
-                return "INACTIVE-LAYER";
-            }
-            return "COMPLETE";
-        }
