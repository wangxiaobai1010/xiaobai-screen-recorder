-        std::uint64_t HashClockMetrics(
-            const std::vector<ClockSimulationMetrics>& metrics) noexcept
-        {
-            std::uint64_t hash{ 14'695'981'039'346'656'037ull };
-            const auto add = [&](const auto value)
-            {
-                const auto* const bytes = reinterpret_cast<const std::uint8_t*>(
-                    &value);
-                for (std::size_t index = 0; index < sizeof(value); ++index)
-                {
-                    hash ^= bytes[index];
-                    hash *= 1'099'511'628'211ull;
-                }
-            };
-            for (const auto& item : metrics)
-            {
-                add(item.microphonePpm);
-                add(item.correctionDetected);
-                add(item.outputFrames);
-                add(item.minimumBufferedFrames);
-                add(item.maximumBufferedFrames);
-                add(item.maximumAbsolutePhaseFrames);
-                add(item.finalPhaseFrames);
-                add(item.finalAppliedPpm);
-                add(item.hardInsertFrames);
-                add(item.hardDropFrames);
-            }
-            return hash;
-        }
