-                    inactiveDirectory / L"01-system-post-convert.wav") &&
-                !std::filesystem::exists(
-                    inactiveDirectory /
-                        L"02-actual-aac-writer-input.wav");
-
-            SetEnvironmentVariableW(
-                L"XB_PREVIEW_MIC_NOISE_DIAGNOSTIC_DIR", nullptr);
-            SetEnvironmentVariableW(
-                L"XB_PREVIEW_MIC_NOISE_DIAGNOSTIC_SECONDS", nullptr);
-            SetEnvironmentVariableW(
-                L"XB_PREVIEW_AUDIO_DIAGNOSTIC_SOURCE", nullptr);
-            SetEnvironmentVariableW(
-                L"XB_AUDIO_REGRESSION_DIAGNOSTIC", nullptr);
-            if (activePassed && inactivePassed)
