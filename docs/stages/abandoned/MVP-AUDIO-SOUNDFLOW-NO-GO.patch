-                    "\"actualRecordingSessionId\": "
-                    "\"28000000-0000-4000-8000-0000000000AA\"") !=
-                    std::string::npos &&
-                binding.find(
-                    "\"diagnosticRunToken\": "
-                    "\"D9000000-0000-4000-8000-000000000001\"") !=
-                    std::string::npos &&
-                binding.find("\"encoderGeneration\": 7") !=
-                    std::string::npos &&
-                binding.find("decoded-fixture.mp4") !=
-                    std::string::npos &&
-                !std::filesystem::exists(
-                    bindingPath.wstring() + L".tmp-" +
-                    std::to_wstring(GetCurrentProcessId()));
-
-            SetEnvironmentVariableW(
-                L"XB_PREVIEW_MIC_NOISE_DIAGNOSTIC_DIR",
