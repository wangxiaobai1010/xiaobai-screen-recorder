-        std::int64_t FrameToMediaTime100ns(
-            const std::uint64_t frame) noexcept
-        {
-            return static_cast<std::int64_t>(
-                frame * AudioHundredNanosecondsPerSecond /
-                AudioOutputSampleRate);
-        }
-
-        std::int64_t FloorFrameFromMediaDelta(
-            const std::int64_t delta100ns) noexcept
-        {
-            if (delta100ns >= 0)
-            {
-                return static_cast<std::int64_t>(
-                    static_cast<std::uint64_t>(delta100ns) *
-                    AudioOutputSampleRate /
-                    AudioHundredNanosecondsPerSecond);
-            }
-            const auto magnitude = static_cast<std::uint64_t>(-delta100ns);
-            return -static_cast<std::int64_t>(
-                (magnitude * AudioOutputSampleRate +
-                    AudioHundredNanosecondsPerSecond - 1) /
-                AudioHundredNanosecondsPerSecond);
-        }
-
-        std::uint32_t AbsolutePcm16(const std::int16_t value) noexcept
-        {
-            const auto wide = static_cast<std::int32_t>(value);
-            return static_cast<std::uint32_t>(wide < 0 ? -wide : wide);
-        }
-
-        LayerStatistics Statistics(const LayerState& layer) noexcept
-        {
-            LayerStatistics result{};
-            result.frames = layer.pcm.size() / AudioOutputChannels;
-            long double sumSquares{};
-            for (std::size_t frame = 0; frame < result.frames; ++frame)
-            {
-                bool nonzero{};
-                for (std::uint32_t channel = 0;
-                     channel < AudioOutputChannels; ++channel)
-                {
-                    const auto value = layer.pcm[
-                        frame * AudioOutputChannels + channel];
-                    result.peak = (std::max)(
-                        result.peak, AbsolutePcm16(value));
-                    nonzero = nonzero || value != 0;
-                    const auto wide = static_cast<long double>(value);
-                    sumSquares += wide * wide;
-                }
-                if (nonzero)
-                {
-                    ++result.nonzeroFrames;
-                }
-            }
-            const auto sampleCount = layer.pcm.size();
-            result.rms = sampleCount == 0
-                ? 0.0
-                : std::sqrt(static_cast<double>(
-                    sumSquares / static_cast<long double>(sampleCount)));
-            return result;
-        }
