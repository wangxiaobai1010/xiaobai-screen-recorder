-
-    void MicNoiseDiagnosticTapBindEncoder(
-        const wchar_t* const recordingSessionId,
-        const std::uint64_t encoderGeneration,
-        const wchar_t* const plannedFinalPath) noexcept
-    {
-        if (recordingSessionId == nullptr || recordingSessionId[0] == L'\0' ||
-            encoderGeneration == 0 || plannedFinalPath == nullptr ||
-            plannedFinalPath[0] == L'\0')
-        {
-            return;
-        }
-        try
-        {
-            if (!state.enabled.load(std::memory_order_acquire) &&
-                !MicNoiseDiagnosticTapRequested())
-            {
-                return;
-            }
-            std::lock_guard lifecycleLock(lifecycleMutex);
-            std::lock_guard dataLock(dataMutex);
-            const std::wstring requestedSessionId(recordingSessionId);
-            const std::wstring requestedPlannedFinalPath(plannedFinalPath);
-            const auto requestedRunToken = ReadEnvironment(
-                DiagnosticRunTokenVariable);
-            const auto requestedDirectory = ReadEnvironment(
-                DiagnosticDirectoryVariable);
-            if (pendingEncoderBinding &&
-                (pendingEncoderSessionId != requestedSessionId ||
-                 pendingEncoderGeneration != encoderGeneration ||
-                 pendingEncoderPlannedFinalPath !=
-                    requestedPlannedFinalPath ||
-                 pendingDiagnosticRunToken != requestedRunToken))
-            {
-                state.encoderBindingConflict = true;
-                return;
-            }
-            const auto handshakeResult = requestedRunToken.empty()
-                ? E_PENDING
-                : WriteSessionBinding(
-                    requestedDirectory,
-                    requestedRunToken,
-                    requestedSessionId,
-                    encoderGeneration,
-                    requestedPlannedFinalPath);
-            pendingEncoderSessionId = requestedSessionId;
-            pendingEncoderPlannedFinalPath = requestedPlannedFinalPath;
-            pendingDiagnosticRunToken = requestedRunToken;
-            pendingEncoderGeneration = encoderGeneration;
-            pendingEncoderBinding = true;
-            pendingSessionBindingWriteHResult = handshakeResult;
-            if (state.enabled.load(std::memory_order_acquire))
-            {
-                if (state.encoderBound &&
-                    (state.recordingSessionId != requestedSessionId ||
-                     state.encoderGeneration != encoderGeneration ||
-                     state.plannedFinalPath !=
-                        requestedPlannedFinalPath ||
-                     state.diagnosticRunToken != requestedRunToken))
-                {
-                    state.encoderBindingConflict = true;
-                    return;
-                }
-                state.diagnosticRunToken = requestedRunToken;
-                state.recordingSessionId = requestedSessionId;
-                state.plannedFinalPath = requestedPlannedFinalPath;
-                state.encoderGeneration = encoderGeneration;
-                state.encoderBound = true;
-                state.sessionBindingWriteHResult = handshakeResult;
-            }
-        }
-        catch (...)
-        {
-            // Diagnostic identity must never affect production recording.
-        }
-    }
-
-    void MicNoiseDiagnosticTapAppendPostConvert(
-        const std::int16_t* const interleavedPcm,
-        const std::uint32_t frameCount,
-        const std::int64_t packetQpc100ns) noexcept
-    {
-        if (!state.enabled.load(std::memory_order_acquire) ||
-            interleavedPcm == nullptr || frameCount == 0 ||
-            packetQpc100ns <= 0)
-        {
-            return;
-        }
-        std::lock_guard lock(dataMutex);
-        state.postConvert.sourceFramesObserved += frameCount;
-        if (!state.programOriginSet)
-        {
-            return;
-        }
-        if (!state.anchorSet)
-        {
-            for (std::uint32_t frame = 0; frame < frameCount; ++frame)
-            {
-                const auto absolutePts = packetQpc100ns +
-                    FrameToMediaTime100ns(frame);
-                if (absolutePts < state.programOriginQpc100ns)
-                {
-                    continue;
-                }
-                std::uint32_t peak{};
-                for (std::uint32_t channel = 0;
-                     channel < AudioOutputChannels; ++channel)
-                {
-                    peak = (std::max)(peak, AbsolutePcm16(interleavedPcm[
-                        static_cast<std::size_t>(frame) *
-                            AudioOutputChannels + channel]));
-                }
-                if (peak >= AudioSignalThresholdPcm16)
-                {
-                    const auto anchorFrame = FloorFrameFromMediaDelta(
-                        absolutePts - state.programOriginQpc100ns);
-                    state.windowStartPts100ns = FrameToMediaTime100ns(
-                        static_cast<std::uint64_t>((std::max)(
-                            anchorFrame, static_cast<std::int64_t>(0))));
