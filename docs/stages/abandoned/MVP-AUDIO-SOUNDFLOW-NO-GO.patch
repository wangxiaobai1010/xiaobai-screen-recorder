-                            state.mp4Decoded,
-                            pcm, frameCount, timestamp);
-                    }
-                    winrt::check_hresult(buffer->Unlock());
-                }
-                if (scalarSampleCount != 0)
-                {
-                    facts.rmsPcm16 = static_cast<double>(std::sqrt(
-                        sumSquares /
-                        static_cast<long double>(scalarSampleCount)));
-                }
-            }
-            catch (const winrt::hresult_error& error)
-            {
-                result = error.code();
-            }
-            catch (...)
-            {
-                result = E_FAIL;
-            }
