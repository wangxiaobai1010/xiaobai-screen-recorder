-    HRESULT MiniaudioSystemCapture::Start() noexcept
-    {
-        if (!impl_ || !impl_->captureInitialized ||
-            !impl_->silenceClockInitialized)
-            return E_UNEXPECTED;
-        {
-            std::lock_guard lock(impl_->mutex);
-            if (impl_->started) return S_FALSE;
-        }
-        auto result = ma_device_start(&impl_->captureDevice);
-        if (result != MA_SUCCESS)
-        {
-            const auto failure = ToHResult(result);
-            {
-                std::lock_guard lock(impl_->mutex);
-                impl_->diagnostics.startHResult = failure;
-            }
-            impl_->RecordTerminal(failure);
-            return failure;
-        }
-        {
-            std::lock_guard lock(impl_->mutex);
-            impl_->diagnostics.captureDeviceStarted = true;
-        }
-        result = ma_device_start(&impl_->silenceClockDevice);
-        if (result != MA_SUCCESS)
-        {
-            const auto failure = ToHResult(result);
-            (void)ma_device_stop(&impl_->captureDevice);
-            {
-                std::lock_guard lock(impl_->mutex);
-                impl_->diagnostics.captureDeviceStopped = true;
-                impl_->diagnostics.startHResult = failure;
-            }
-            impl_->RecordTerminal(failure);
-            return failure;
-        }
-        {
-            std::lock_guard lock(impl_->mutex);
-            impl_->diagnostics.silenceClockDeviceStarted = true;
-            impl_->diagnostics.startHResult = S_OK;
-            impl_->started = true;
-            impl_->stopped = false;
-        }
-        return S_OK;
-    }
-
-    void MiniaudioSystemCapture::Stop() noexcept
-    {
-        if (!impl_) return;
-        {
-            std::lock_guard lock(impl_->mutex);
-            if (impl_->stopped) return;
-        }
-        HRESULT failure = S_OK;
-        const auto beforeStop = Diagnostics();
-        bool silenceClockStopped = beforeStop.silenceClockDeviceStopped;
-        bool captureStopped = beforeStop.captureDeviceStopped;
-        if (impl_->silenceClockInitialized &&
-            beforeStop.silenceClockDeviceStarted)
-        {
-            const auto result = ma_device_stop(&impl_->silenceClockDevice);
-            if (result != MA_SUCCESS) failure = ToHResult(result);
-            silenceClockStopped = result == MA_SUCCESS;
-        }
-        if (impl_->captureInitialized &&
-            beforeStop.captureDeviceStarted)
-        {
-            const auto result = ma_device_stop(&impl_->captureDevice);
-            if (result != MA_SUCCESS && SUCCEEDED(failure))
-                failure = ToHResult(result);
-            captureStopped = result == MA_SUCCESS;
-        }
-        {
-            std::lock_guard lock(impl_->mutex);
-            impl_->diagnostics.silenceClockDeviceStopped =
-                silenceClockStopped;
-            impl_->diagnostics.captureDeviceStopped = captureStopped;
-            impl_->started = false;
-            impl_->stopped = true;
-        }
-        impl_->RecordTerminal(failure);
-    }
-
-    void MiniaudioSystemCapture::Shutdown() noexcept
-    {
-        if (!impl_) return;
-        Stop();
-        if (impl_->silenceClockInitialized)
-        {
-            ma_device_uninit(&impl_->silenceClockDevice);
-            impl_->silenceClockInitialized = false;
-        }
-        if (impl_->captureInitialized)
-        {
-            ma_device_uninit(&impl_->captureDevice);
-            impl_->captureInitialized = false;
-        }
-        {
-            std::lock_guard lock(impl_->mutex);
-            impl_->diagnostics.devicesUninitialized = true;
-        }
-        if (impl_->contextInitialized)
-        {
-            ma_context_uninit(&impl_->context);
-            impl_->contextInitialized = false;
-        }
-        {
-            std::lock_guard lock(impl_->mutex);
-            impl_->diagnostics.contextUninitialized = true;
-            impl_->diagnostics.resourcesReleased = true;
-        }
-    }
-
-    bool MiniaudioSystemCapture::TryPop(
-        std::vector<std::int16_t>& interleavedPcm) noexcept
-    {
-        interleavedPcm.clear();
-        if (!impl_) return false;
-        std::lock_guard lock(impl_->mutex);
-        if (impl_->queueFrames == 0) return false;
-        const auto frames = (std::min)(
-            impl_->queueFrames, DrainBlockFrames);
-        try
-        {
-            interleavedPcm.resize(frames * OutputChannels);
-        }
-        catch (...)
-        {
-            if (SUCCEEDED(impl_->diagnostics.terminalHResult))
-                impl_->diagnostics.terminalHResult = E_OUTOFMEMORY;
-            return false;
-        }
-        auto remaining = frames;
-        auto outputFrame = std::size_t{};
-        while (remaining != 0)
-        {
-            const auto contiguous = (std::min)(
-                remaining, QueueCapacityFrames - impl_->queueReadFrame);
-            std::copy_n(
-                impl_->queue.data() +
-                    impl_->queueReadFrame * OutputChannels,
-                contiguous * OutputChannels,
-                interleavedPcm.data() + outputFrame * OutputChannels);
-            impl_->queueReadFrame =
-                (impl_->queueReadFrame + contiguous) % QueueCapacityFrames;
-            outputFrame += contiguous;
-            remaining -= contiguous;
-        }
-        impl_->queueFrames -= frames;
-        impl_->diagnostics.queueFramesCurrent = impl_->queueFrames;
-        return true;
-    }
-
-    MiniaudioSystemCaptureDiagnostics
-    MiniaudioSystemCapture::Diagnostics() const noexcept
-    {
-        if (!impl_) return {};
-        std::lock_guard lock(impl_->mutex);
-        auto result = impl_->diagnostics;
-        result.queueFramesCurrent = impl_->queueFrames;
-        return result;
-    }
-
-    bool MiniaudioSystemCapture::Running() const noexcept
-    {
-        if (!impl_) return false;
-        std::lock_guard lock(impl_->mutex);
-        return impl_->started;
-    }
-}
