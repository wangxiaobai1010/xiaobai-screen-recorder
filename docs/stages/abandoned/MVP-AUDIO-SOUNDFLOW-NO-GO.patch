-    AudioProgramMixer::AudioProgramMixer()
-        : impl_(std::make_unique<Impl>())
-    {
-    }
-
-    AudioProgramMixer::~AudioProgramMixer()
-    {
-        AbortAndJoin();
-    }
-
-    HRESULT AudioProgramMixer::Start(
-        const AudioCaptureSource programSource,
-        const bool injectInitializationFailure) noexcept
-    {
-        if (!impl_ || (programSource != AudioCaptureSource::SystemLoopback &&
-            programSource != AudioCaptureSource::DefaultMicrophone &&
-            programSource !=
-                AudioCaptureSource::SystemLoopbackAndMicrophone))
-        {
-            return E_INVALIDARG;
-        }
-        AbortAndJoin();
-        {
-            std::lock_guard lock(impl_->mutex);
-            impl_->diagnostics = {};
-            impl_->outputQueue.clear();
-            impl_->programSource = programSource;
-            impl_->originQpc100ns = 0;
-            impl_->targetQpc100ns = 0;
-            impl_->originPending = false;
-            impl_->originApplied = false;
-            impl_->sealRequested = false;
-            impl_->abortRequested = false;
-            impl_->diagnostics.dualRequested = programSource ==
-                AudioCaptureSource::SystemLoopbackAndMicrophone;
-            impl_->diagnostics.desiredControls = impl_->desiredControls;
-            impl_->appliedControlRevision = 0;
-        }
-        impl_->sourcesStopping.store(false);
-        const auto systemRequested = RequestsSystem(programSource);
-        const auto microphoneRequested = RequestsMicrophone(programSource);
-        const auto systemResult = systemRequested
-            ? impl_->systemCapture.Start(
-                AudioCaptureSource::SystemLoopback,
-                injectInitializationFailure)
-            : S_FALSE;
-        const auto microphoneResult = microphoneRequested
-            ? impl_->microphoneCapture.Start(
-                AudioCaptureSource::DefaultMicrophone,
-                injectInitializationFailure)
-            : S_FALSE;
-        impl_->systemAvailable = systemRequested && SUCCEEDED(systemResult);
-        impl_->microphoneAvailable =
-            microphoneRequested && SUCCEEDED(microphoneResult);
-        {
-            std::lock_guard lock(impl_->mutex);
-            impl_->diagnostics.systemStartHResult = systemResult;
-            impl_->diagnostics.microphoneStartHResult = microphoneResult;
-            impl_->diagnostics.degradedToSingleSource =
-                impl_->diagnostics.dualRequested &&
-                (!impl_->systemAvailable || !impl_->microphoneAvailable);
-        }
-        impl_->RefreshCaptureDiagnostics();
-        if (!impl_->systemAvailable && !impl_->microphoneAvailable)
-        {
-            StopSources();
-            return FAILED(systemResult) ? systemResult : microphoneResult;
-        }
-        try
-        {
-            impl_->worker = std::thread([this]
-            {
-                impl_->ThreadMain();
-            });
-        }
-        catch (const std::bad_alloc&)
-        {
-            StopSources();
-            return E_OUTOFMEMORY;
-        }
-        catch (...)
-        {
-            StopSources();
-            return E_UNEXPECTED;
-        }
-        return S_OK;
-    }
-
-    HRESULT AudioProgramMixer::SetOrigin(
-        const std::int64_t originQpc100ns) noexcept
-    {
-        if (!impl_ || originQpc100ns <= 0)
-        {
-            return E_INVALIDARG;
-        }
-        std::lock_guard lock(impl_->mutex);
-        if (impl_->originPending || impl_->originApplied ||
-            impl_->sealRequested || impl_->abortRequested)
-        {
-            return HRESULT_FROM_WIN32(ERROR_INVALID_STATE);
-        }
-        impl_->originQpc100ns = originQpc100ns;
-        impl_->targetQpc100ns = originQpc100ns;
-        impl_->originPending = true;
-        impl_->condition.notify_all();
-        return S_OK;
-    }
-
-    HRESULT AudioProgramMixer::SetControls(
-        const bool systemMuted,
-        const bool microphoneMuted,
-        const double microphoneGainDb) noexcept
-    {
-        if (!impl_ || !std::isfinite(microphoneGainDb))
-        {
-            return E_INVALIDARG;
-        }
-        std::lock_guard lock(impl_->mutex);
-        impl_->desiredControls.systemMuted = systemMuted;
-        impl_->desiredControls.microphoneMuted = microphoneMuted;
-        const auto boundedGain = std::clamp(
-            microphoneGainDb,
-            AudioMicrophoneGainMinimumDb,
-            AudioMicrophoneGainMaximumDb);
-        impl_->desiredControls.microphoneGainParameterClamped =
-            boundedGain != microphoneGainDb;
-        impl_->desiredControls.microphoneGainDb = boundedGain;
-        ++impl_->desiredControls.revision;
-        if (impl_->desiredControls.revision == 0)
-        {
-            ++impl_->desiredControls.revision;
-        }
-        impl_->diagnostics.desiredControls = impl_->desiredControls;
-        impl_->condition.notify_all();
-        return S_OK;
-    }
-
-    void AudioProgramMixer::RequestThrough(
-        const std::int64_t targetQpc100ns) noexcept
-    {
-        if (!impl_)
-        {
-            return;
-        }
-        std::lock_guard lock(impl_->mutex);
-        if (!impl_->sealRequested && !impl_->abortRequested)
-        {
-            impl_->targetQpc100ns = (std::max)(
-                impl_->targetQpc100ns, targetQpc100ns);
-            impl_->condition.notify_all();
-        }
-    }
-
-    void AudioProgramMixer::StopSources() noexcept
-    {
-        if (!impl_)
-        {
-            return;
-        }
-        std::lock_guard stopLock(impl_->sourceStopMutex);
-        if (impl_->sourcesStopping.exchange(true))
-        {
-            return;
-        }
-        impl_->systemCapture.Stop();
-        impl_->microphoneCapture.Stop();
-        impl_->RefreshCaptureDiagnostics();
-        std::lock_guard lock(impl_->mutex);
-        impl_->diagnostics.sourcesStopped = true;
-        impl_->condition.notify_all();
-    }
-
-    HRESULT AudioProgramMixer::SealAndJoin(
-        const std::int64_t finalTargetQpc100ns) noexcept
-    {
-        if (!impl_)
-        {
-            return E_POINTER;
-        }
-        StopSources();
-        {
-            std::lock_guard lock(impl_->mutex);
-            impl_->targetQpc100ns = (std::max)(
-                impl_->targetQpc100ns, finalTargetQpc100ns);
-            impl_->sealRequested = true;
-            impl_->condition.notify_all();
-        }
-        if (impl_->worker.joinable())
-        {
-            if (impl_->worker.get_id() == std::this_thread::get_id())
-            {
-                return HRESULT_FROM_WIN32(ERROR_POSSIBLE_DEADLOCK);
-            }
-            impl_->worker.join();
-        }
-        const auto diagnostics = Diagnostics();
-        return diagnostics.terminalHResult;
-    }
-
-    void AudioProgramMixer::AbortAndJoin() noexcept
-    {
-        if (!impl_)
-        {
-            return;
-        }
-        StopSources();
-        {
-            std::lock_guard lock(impl_->mutex);
-            impl_->abortRequested = true;
-            impl_->condition.notify_all();
-        }
-        if (impl_->worker.joinable() &&
-            impl_->worker.get_id() != std::this_thread::get_id())
-        {
-            impl_->worker.join();
-        }
-        AudioCapturePacket discarded{};
-        while (impl_->systemCapture.TryPop(discarded))
-        {
-            discarded = {};
-        }
-        while (impl_->microphoneCapture.TryPop(discarded))
-        {
-            discarded = {};
-        }
-        std::lock_guard lock(impl_->mutex);
-        impl_->outputQueue.clear();
-        impl_->diagnostics.outputQueueFramesCurrent = 0;
-        impl_->diagnostics.outputQueueBlocksCurrent = 0;
-    }
-
-    bool AudioProgramMixer::TryPop(AudioProgramPcmBlock& block) noexcept
-    {
-        if (!impl_)
-        {
-            return false;
-        }
-        std::lock_guard lock(impl_->mutex);
-        if (impl_->outputQueue.empty())
-        {
-            return false;
-        }
-        block = std::move(impl_->outputQueue.front());
-        impl_->diagnostics.outputQueueFramesCurrent -= block.frameCount;
-        impl_->outputQueue.pop_front();
-        impl_->diagnostics.outputQueueBlocksCurrent =
-            static_cast<std::uint32_t>(impl_->outputQueue.size());
-        return true;
-    }
-
-    AudioProgramMixerDiagnostics AudioProgramMixer::Diagnostics() const noexcept
-    {
-        if (!impl_)
-        {
-            return {};
-        }
-        const auto system = impl_->systemCapture.Diagnostics();
-        const auto microphone = impl_->microphoneCapture.Diagnostics();
-        std::lock_guard lock(impl_->mutex);
-        auto result = impl_->diagnostics;
-        result.systemCapture = system;
-        result.microphoneCapture = microphone;
-        const auto systemReleased =
-            impl_->programSource == AudioCaptureSource::DefaultMicrophone ||
-            system.resourcesReleased;
-        const auto microphoneReleased =
-            impl_->programSource == AudioCaptureSource::SystemLoopback ||
-            microphone.resourcesReleased;
-        result.resourcesReleased = result.workerExited &&
-            result.sourcesStopped && systemReleased && microphoneReleased &&
-            impl_->outputQueue.empty();
-        return result;
-    }
-}
