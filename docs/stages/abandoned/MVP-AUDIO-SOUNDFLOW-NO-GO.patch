-
-        double QuantizeRatioToOnePpm(const double ratio) noexcept
-        {
-            const auto ppm = std::round(
-                (ratio - 1.0) * RationalDenominator);
-            return 1.0 + ppm / RationalDenominator;
-        }
-
-        ClockSimulationMetrics SimulateDualClock(const int microphonePpm)
-        {
-            constexpr double blockFrames = 1'024.0;
-            constexpr double blockSeconds = blockFrames / SampleRate;
-            constexpr std::uint64_t twoHourOutputFrames =
-                static_cast<std::uint64_t>(SampleRate) * 2 * 60 * 60;
-            constexpr std::uint64_t blockCount =
-                twoHourOutputFrames / static_cast<std::uint64_t>(blockFrames);
-            constexpr double targetBufferedFrames = SampleRate * 0.100;
-            constexpr double maximumBufferedFrames = SampleRate * 5.0;
-            constexpr double deadbandFrames = SampleRate * 0.020;
-            constexpr double observationSeconds = 5.0;
-            constexpr double correctionHorizonSeconds = 20.0;
-            constexpr double maximumCorrection = 1'000.0 /
-                RationalDenominator;
-            constexpr std::array<double, 8> observedPhaseJitterFrames{
-                -96.0, 48.0, -48.0, 96.0, 0.0, 24.0, -24.0, 0.0 };
-
-            ClockSimulationMetrics metrics{};
-            metrics.microphonePpm = microphonePpm;
-            auto bufferedFrames = targetBufferedFrames;
-            metrics.minimumBufferedFrames = bufferedFrames;
-            metrics.maximumBufferedFrames = bufferedFrames;
-            const auto hardwareRatio = 1.0 +
-                static_cast<double>(microphonePpm) / RationalDenominator;
-            auto appliedRatio = 1.0;
-            auto targetRatio = 1.0;
-            auto persistentSeconds = 0.0;
-            int persistentSign{};
-            bool controllerLocked{};
-
-            for (std::uint64_t block = 0; block < blockCount; ++block)
-            {
-                const auto normalizedProducedFrames =
-                    blockFrames * hardwareRatio / appliedRatio;
-                bufferedFrames += normalizedProducedFrames - blockFrames;
-                const auto phaseFrames = bufferedFrames - targetBufferedFrames;
-                const auto observedPhase = phaseFrames +
-                    observedPhaseJitterFrames[
-                        static_cast<std::size_t>(block) %
-                        observedPhaseJitterFrames.size()];
-                const auto observedSign = observedPhase > deadbandFrames
-                    ? 1
-                    : observedPhase < -deadbandFrames ? -1 : 0;
-
-                if (!controllerLocked)
-                {
-                    if (observedSign != 0 && observedSign == persistentSign)
-                    {
-                        persistentSeconds += blockSeconds;
-                    }
-                    else
-                    {
-                        persistentSign = observedSign;
-                        persistentSeconds = observedSign == 0
-                            ? 0.0
-                            : blockSeconds;
-                    }
-                    if (persistentSeconds >= observationSeconds)
-                    {
-                        controllerLocked = true;
-                    }
-                }
-
-                if (controllerLocked)
-                {
-                    const auto phaseSeconds = phaseFrames / SampleRate;
-                    targetRatio = std::clamp(
-                        hardwareRatio +
-                            phaseSeconds / correctionHorizonSeconds,
-                        1.0 - maximumCorrection,
-                        1.0 + maximumCorrection);
-                    targetRatio = QuantizeRatioToOnePpm(targetRatio);
-                }
-
-                const auto maximumRatioStep =
-                    maximumCorrection / correctionHorizonSeconds *
-                    blockSeconds;
-                if (appliedRatio < targetRatio)
-                {
-                    appliedRatio = (std::min)(
-                        appliedRatio + maximumRatioStep,
-                        targetRatio);
-                }
-                else if (appliedRatio > targetRatio)
-                {
-                    appliedRatio = (std::max)(
-                        appliedRatio - maximumRatioStep,
-                        targetRatio);
-                }
-                appliedRatio = QuantizeRatioToOnePpm(appliedRatio);
-
-                metrics.minimumBufferedFrames = (std::min)(
-                    metrics.minimumBufferedFrames, bufferedFrames);
-                metrics.maximumBufferedFrames = (std::max)(
-                    metrics.maximumBufferedFrames, bufferedFrames);
-                metrics.maximumAbsolutePhaseFrames = (std::max)(
-                    metrics.maximumAbsolutePhaseFrames,
-                    std::abs(phaseFrames));
-                metrics.outputFrames +=
-                    static_cast<std::uint64_t>(blockFrames);
-            }
-
-            metrics.correctionDetected = controllerLocked;
-            metrics.finalPhaseFrames = bufferedFrames - targetBufferedFrames;
-            metrics.finalAppliedPpm =
-                (appliedRatio - 1.0) * RationalDenominator;
-
-            SpikeRequire(
-                metrics.outputFrames == twoHourOutputFrames,
-                "P2.8D Spike simulated program cursor is exact");
-            SpikeRequire(
-                metrics.minimumBufferedFrames > 0.0 &&
-                metrics.maximumBufferedFrames < maximumBufferedFrames &&
-                metrics.maximumAbsolutePhaseFrames <= SampleRate * 0.050,
-                "P2.8D Spike simulated drift remains bounded");
-            SpikeRequire(
-                metrics.hardInsertFrames == 0 &&
-                metrics.hardDropFrames == 0,
-                "P2.8D Spike normal drift uses no hard correction");
-            if (microphonePpm == 0)
-            {
-                SpikeRequire(
-                    !metrics.correctionDetected &&
-                    std::abs(metrics.finalPhaseFrames) < 0.001 &&
-                    std::abs(metrics.finalAppliedPpm) < 0.001,
-                    "P2.8D Spike nominal clock stays neutral");
-            }
-            else
-            {
-                SpikeRequire(
-                    metrics.correctionDetected &&
-                    std::abs(metrics.finalAppliedPpm - microphonePpm) <= 1.0 &&
-                    std::abs(metrics.finalPhaseFrames) <= SampleRate * 0.050,
-                    "P2.8D Spike detects and corrects fast or slow clock");
-            }
-            return metrics;
-        }
