-        void CopyTimedPcmLocked(
-            LayerState& layer,
-            const std::int16_t* const pcm,
-            const std::uint32_t frameCount,
-            const std::int64_t sampleTime100ns) noexcept
-        {
-            layer.sourceFramesObserved += frameCount;
-            if (!state.anchorSet || pcm == nullptr || frameCount == 0)
-            {
-                return;
-            }
-            auto destinationFrame = FloorFrameFromMediaDelta(
-                sampleTime100ns - state.windowStartPts100ns);
-            std::uint64_t sourceFrame{};
-            if (destinationFrame < 0)
-            {
-                sourceFrame = static_cast<std::uint64_t>(-destinationFrame);
-                destinationFrame = 0;
-            }
-            if (sourceFrame >= frameCount ||
-                static_cast<std::uint64_t>(destinationFrame) >=
-                    state.windowFrames)
-            {
-                return;
-            }
-            const auto availableSource =
-                static_cast<std::uint64_t>(frameCount) - sourceFrame;
-            const auto availableDestination = state.windowFrames -
-                static_cast<std::uint64_t>(destinationFrame);
-            const auto copied = (std::min)(
-                availableSource, availableDestination);
-            std::memcpy(
-                layer.pcm.data() +
-                    static_cast<std::size_t>(destinationFrame) *
-                        AudioOutputChannels,
-                pcm + static_cast<std::size_t>(sourceFrame) *
-                    AudioOutputChannels,
-                static_cast<std::size_t>(copied) * AudioOutputChannels *
-                    sizeof(std::int16_t));
-            layer.sourceFramesCopied += copied;
-            const auto firstPts = state.windowStartPts100ns +
-                FrameToMediaTime100ns(
-                    static_cast<std::uint64_t>(destinationFrame));
-            const auto lastPts = state.windowStartPts100ns +
-                FrameToMediaTime100ns(
-                    static_cast<std::uint64_t>(destinationFrame) + copied);
-            if (!layer.haveCapturedPts)
-            {
-                layer.firstCapturedPts100ns = firstPts;
-                layer.lastCapturedPts100ns = lastPts;
-                layer.haveCapturedPts = true;
-            }
-            else
-            {
-                layer.firstCapturedPts100ns = (std::min)(
-                    layer.firstCapturedPts100ns, firstPts);
-                layer.lastCapturedPts100ns = (std::max)(
-                    layer.lastCapturedPts100ns, lastPts);
-            }
-        }
