-internal sealed class NAudioMicrophoneSession : INAudioMicrophoneSession
-{
-    private const string MetadataFileName = "mic-naudio.json";
-    private readonly object _gate = new();
-    private readonly MMDeviceEnumerator _enumerator;
-    private readonly MMDevice _device;
-    private readonly WasapiCapture _capture;
-    private SegmentedWaveFileWriter? _writer;
-    private string? _sidecarDirectory;
-    private string? _terminalError;
-    private bool _acceptData;
-    private bool _started;
-    private bool _stopped;
-    private bool _writerSealed;
-    private bool _disposed;
-
-    private NAudioMicrophoneSession(
-        MMDeviceEnumerator enumerator,
-        MMDevice device,
-        WasapiCapture capture,
-        string endpointId,
-        string friendlyName)
-    {
-        _enumerator = enumerator;
-        _device = device;
-        _capture = capture;
-        EndpointId = endpointId;
-        FriendlyName = friendlyName;
-    }
-
-    public string EndpointId { get; }
-
-    public event EventHandler<MicrophoneCaptureStoppedEventArgs>?
-        CaptureStopped;
-
-    public string FriendlyName { get; }
-
-    public WaveFormat WaveFormat => _capture.WaveFormat;
-
-    internal static NAudioMicrophoneSession CreateDefault()
-    {
-        MMDeviceEnumerator? enumerator = null;
-        MMDevice? device = null;
-        WasapiCapture? capture = null;
-        try
-        {
-            enumerator = new MMDeviceEnumerator();
-            try
-            {
-                device = enumerator.GetDefaultAudioEndpoint(
-                    DataFlow.Capture,
-                    Role.Console);
-            }
-            catch (Exception error)
-            {
-                throw new MicrophoneUnavailableAtStartException(error);
-            }
-            if ((device.State & DeviceState.Active) == 0 ||
-                string.IsNullOrWhiteSpace(device.ID))
-            {
-                throw new MicrophoneUnavailableAtStartException();
-            }
-            string endpointId = device.ID;
-            string friendlyName = device.FriendlyName;
-            capture = new WasapiCapture(device);
-            return new NAudioMicrophoneSession(
-                enumerator,
-                device,
-                capture,
-                endpointId,
-                friendlyName);
-        }
-        catch (MicrophoneUnavailableAtStartException)
-        {
-            capture?.Dispose();
-            device?.Dispose();
-            enumerator?.Dispose();
-            throw;
-        }
-        catch (Exception error)
-        {
-            capture?.Dispose();
-            device?.Dispose();
-            enumerator?.Dispose();
-            throw new MicrophoneUnavailableAtStartException(error);
-        }
-    }
-
-    public void Start(string sidecarDirectory)
-    {
-        ArgumentException.ThrowIfNullOrWhiteSpace(sidecarDirectory);
-        lock (_gate)
-        {
-            ObjectDisposedException.ThrowIf(_disposed, this);
-            if (_started)
-            {
-                throw new InvalidOperationException(
-                    "The NAudio microphone session is already started.");
-            }
-            _writer = new SegmentedWaveFileWriter(
-                sidecarDirectory,
-                WaveFormat);
-            _sidecarDirectory = sidecarDirectory;
-            _capture.DataAvailable += OnDataAvailable;
-            _capture.RecordingStopped += OnRecordingStopped;
-            _acceptData = true;
-            _started = true;
-            WriteMetadataLocked(stopped: false);
-        }
-
-        try
-        {
-            _capture.StartRecording();
-        }
-        catch
-        {
-            Stop();
-            throw;
-        }
-    }
-
-    public void Stop()
-    {
-        lock (_gate)
-        {
-            if (_stopped)
-            {
-                return;
-            }
-            _stopped = true;
-            _acceptData = false;
-        }
-
-        if (_started)
-        {
-            try
-            {
-                _capture.StopRecording();
-            }
-            catch (Exception error)
-            {
-                lock (_gate)
-                {
-                    _terminalError ??= error.Message;
-                }
-            }
-        }
-
-        lock (_gate)
-        {
-            _capture.DataAvailable -= OnDataAvailable;
-            _capture.RecordingStopped -= OnRecordingStopped;
-            SealWriterLocked();
-            WriteMetadataLocked(stopped: true);
-        }
-    }
-
-    public void Dispose()
-    {
-        lock (_gate)
-        {
-            if (_disposed)
-            {
-                return;
-            }
-        }
-        Stop();
-        lock (_gate)
-        {
-            _disposed = true;
-        }
-        _capture.Dispose();
-        _device.Dispose();
-        _enumerator.Dispose();
-    }
-
-    private void OnDataAvailable(object? sender, WaveInEventArgs args)
-    {
-        lock (_gate)
-        {
-            if (!_acceptData || _writer is null || args.BytesRecorded == 0)
-            {
-                return;
-            }
-            try
-            {
-                _writer.Write(args.Buffer, 0, args.BytesRecorded);
-            }
-            catch (Exception error)
-            {
-                _terminalError ??= error.Message;
-                _acceptData = false;
-            }
-        }
-    }
-
-    private void OnRecordingStopped(object? sender, StoppedEventArgs args)
-    {
-        EventHandler<MicrophoneCaptureStoppedEventArgs>? stopped;
-        lock (_gate)
-        {
-            _acceptData = false;
-            _stopped = true;
-            if (args.Exception is not null)
-            {
-                _terminalError ??= args.Exception.Message;
-            }
-            _capture.DataAvailable -= OnDataAvailable;
-            SealWriterLocked();
-            WriteMetadataLocked(stopped: true);
-            stopped = CaptureStopped;
-        }
-        stopped?.Invoke(
-            this,
-            new MicrophoneCaptureStoppedEventArgs(args.Exception));
-    }
-
-    private void SealWriterLocked()
-    {
-        if (_writerSealed)
-        {
-            return;
-        }
-        _writerSealed = true;
-        try
-        {
-            if (_writer is not null && _writer.TotalDataBytes == 0)
-            {
-                // An active endpoint that becomes unavailable before its first
-                // callback is represented as silence, never fabricated PCM.
-                _writer.Write(
-                    new byte[WaveFormat.BlockAlign],
-                    0,
-                    WaveFormat.BlockAlign);
-            }
-            _writer?.Dispose();
-        }
-        catch (Exception error)
-        {
-            _terminalError ??= error.Message;
-        }
-    }
-
-    private void WriteMetadataLocked(bool stopped)
-    {
-        if (string.IsNullOrWhiteSpace(_sidecarDirectory))
-        {
-            return;
-        }
-        try
-        {
-            var facts = new
-            {
-                implementation = "NAudio WasapiCapture",
-                packageVersion = typeof(WasapiCapture).Assembly
-                    .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
-                    .InformationalVersion ??
-                    typeof(WasapiCapture).Assembly.GetName().Version?.ToString(),
-                endpointId = EndpointId,
-                friendlyName = FriendlyName,
-                waveFormat = WaveFormat.ToString(),
-                encoding = WaveFormat.Encoding.ToString(),
-                sampleRate = WaveFormat.SampleRate,
-                channels = WaveFormat.Channels,
-                bitsPerSample = WaveFormat.BitsPerSample,
-                blockAlign = WaveFormat.BlockAlign,
-                dataBytes = _writer?.TotalDataBytes ?? 0,
-                segments = _writer?.SegmentPaths.Select(Path.GetFileName).ToArray() ?? [],
-                stopped,
-                terminalError = _terminalError,
-            };
-            string path = Path.Combine(_sidecarDirectory, MetadataFileName);
-            File.WriteAllText(
-                path,
-                JsonSerializer.Serialize(
-                    facts,
-                    new JsonSerializerOptions { WriteIndented = true }));
-        }
-        catch
-        {
-            // Metadata is evidence only. Capture/file exceptions remain on
-            // the owned sidecar path and must not crash video or system audio.
-        }
-    }
-}
