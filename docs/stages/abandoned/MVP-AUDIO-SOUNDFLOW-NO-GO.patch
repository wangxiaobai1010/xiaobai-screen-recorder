-        HRESULT DecodePublishedMp4(
-            const wchar_t* const path,
-            MicNoiseDiagnosticMp4AudioFacts& facts,
-            const bool mirrorDiagnosticWindow) noexcept
-        {
-            facts = {};
-            if (path == nullptr || path[0] == L'\0')
-            {
-                return E_INVALIDARG;
-            }
-            const auto comResult = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
-            const bool uninitialize = SUCCEEDED(comResult);
-            if (FAILED(comResult) && comResult != RPC_E_CHANGED_MODE)
-            {
-                return comResult;
-            }
-            const auto startupResult = MFStartup(MF_VERSION);
-            if (FAILED(startupResult))
-            {
-                if (uninitialize) CoUninitialize();
-                return startupResult;
-            }
-            HRESULT result = S_OK;
-            try
-            {
-                winrt::com_ptr<IMFSourceReader> reader;
-                winrt::check_hresult(MFCreateSourceReaderFromURL(
-                    path, nullptr, reader.put()));
-                winrt::check_hresult(reader->SetStreamSelection(
-                    static_cast<DWORD>(MF_SOURCE_READER_ALL_STREAMS), FALSE));
-                winrt::check_hresult(reader->SetStreamSelection(
-                    static_cast<DWORD>(MF_SOURCE_READER_FIRST_AUDIO_STREAM),
-                    TRUE));
-                winrt::com_ptr<IMFMediaType> decodedType;
-                winrt::check_hresult(MFCreateMediaType(decodedType.put()));
-                winrt::check_hresult(decodedType->SetGUID(
-                    MF_MT_MAJOR_TYPE, MFMediaType_Audio));
-                winrt::check_hresult(decodedType->SetGUID(
-                    MF_MT_SUBTYPE, MFAudioFormat_PCM));
-                winrt::check_hresult(decodedType->SetUINT32(
-                    MF_MT_AUDIO_NUM_CHANNELS, AudioOutputChannels));
-                winrt::check_hresult(decodedType->SetUINT32(
-                    MF_MT_AUDIO_SAMPLES_PER_SECOND, AudioOutputSampleRate));
-                winrt::check_hresult(decodedType->SetUINT32(
-                    MF_MT_AUDIO_BITS_PER_SAMPLE, 16));
-                winrt::check_hresult(decodedType->SetUINT32(
-                    MF_MT_AUDIO_BLOCK_ALIGNMENT,
-                    AudioOutputChannels * sizeof(std::int16_t)));
-                winrt::check_hresult(decodedType->SetUINT32(
-                    MF_MT_AUDIO_AVG_BYTES_PER_SECOND,
-                    NormalizedBytesPerSecond));
-                winrt::check_hresult(reader->SetCurrentMediaType(
-                    static_cast<DWORD>(MF_SOURCE_READER_FIRST_AUDIO_STREAM),
-                    nullptr, decodedType.get()));
-
-                long double sumSquares{};
-                std::uint64_t scalarSampleCount{};
-                for (;;)
-                {
-                    DWORD flags{};
-                    LONGLONG timestamp{};
-                    winrt::com_ptr<IMFSample> sample;
-                    winrt::check_hresult(reader->ReadSample(
-                        static_cast<DWORD>(MF_SOURCE_READER_FIRST_AUDIO_STREAM),
-                        0, nullptr, &flags, &timestamp, sample.put()));
-                    if ((flags & MF_SOURCE_READERF_ENDOFSTREAM) != 0)
-                    {
-                        break;
-                    }
-                    if (!sample)
-                    {
-                        continue;
-                    }
-                    winrt::com_ptr<IMFMediaBuffer> buffer;
-                    winrt::check_hresult(sample->ConvertToContiguousBuffer(
-                        buffer.put()));
-                    BYTE* bytes{};
-                    DWORD currentLength{};
-                    winrt::check_hresult(buffer->Lock(
-                        &bytes, nullptr, &currentLength));
-                    if (currentLength %
-                            (AudioOutputChannels * sizeof(std::int16_t)) != 0)
-                    {
-                        (void)buffer->Unlock();
-                        winrt::check_hresult(MF_E_INVALIDMEDIATYPE);
-                    }
-                    const auto frameCount = static_cast<std::uint32_t>(
-                        currentLength /
-                        (AudioOutputChannels * sizeof(std::int16_t)));
-                    LONGLONG duration{};
-                    if (FAILED(sample->GetSampleDuration(&duration)) ||
-                        duration <= 0)
-                    {
-                        duration = FrameToMediaTime100ns(frameCount);
-                    }
-                    ++facts.sampleCount;
-                    facts.frameCount += frameCount;
-                    if (!facts.havePts)
-                    {
-                        facts.firstPts100ns = timestamp;
-                        facts.havePts = true;
-                    }
-                    facts.lastPts100ns = timestamp + duration;
-                    const auto* const pcm =
-                        reinterpret_cast<const std::int16_t*>(bytes);
-                    for (std::uint32_t frame = 0;
-                         frame < frameCount; ++frame)
-                    {
-                        bool frameNonzero{};
-                        for (std::uint32_t channel = 0;
-                             channel < AudioOutputChannels; ++channel)
-                        {
-                            const auto value = pcm[
-                                static_cast<std::size_t>(frame) *
-                                    AudioOutputChannels + channel];
-                            const auto absolute = AbsolutePcm16(value);
-                            facts.peakAbsolutePcm16 = (std::max)(
-                                facts.peakAbsolutePcm16, absolute);
-                            frameNonzero = frameNonzero || value != 0;
-                            const auto promoted =
-                                static_cast<long double>(value);
-                            sumSquares += promoted * promoted;
-                            ++scalarSampleCount;
-                        }
-                        if (frameNonzero)
-                        {
-                            ++facts.nonzeroFrameCount;
-                        }
-                    }
-                    if (mirrorDiagnosticWindow)
-                    {
-                        std::lock_guard lock(dataMutex);
