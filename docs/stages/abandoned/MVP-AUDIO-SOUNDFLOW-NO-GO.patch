-        struct ClockSimulationMetrics
-        {
-            int microphonePpm{};
-            bool correctionDetected{};
-            std::uint64_t outputFrames{};
-            double minimumBufferedFrames{};
-            double maximumBufferedFrames{};
-            double maximumAbsolutePhaseFrames{};
