index 2de1964..0000000
--- a/XbPreview.Native/AudioDriftController.cpp
+++ /dev/null
@@ -1,246 +0,0 @@
-#include "AudioDriftController.h"
-
-#include <algorithm>
-#include <cmath>
-
-namespace xbpreview
-{
-    namespace
-    {
-        constexpr double PpmScale = 1'000'000.0;
-        constexpr std::int64_t OutputBlockDuration100ns =
-            static_cast<std::int64_t>(AudioAacFramesPerSample) *
-            AudioHundredNanosecondsPerSecond / AudioOutputSampleRate;
-        constexpr double DeadbandFrames =
-            static_cast<double>(AudioDriftDeadband100ns) *
-            AudioOutputSampleRate / AudioHundredNanosecondsPerSecond;
-    }
-
-    void AudioDriftController::Reset(
-        const std::uint64_t devicePositionFrequency) noexcept
-    {
-        devicePositionFrequency_ = devicePositionFrequency;
-        diagnostics_ = {};
-        ResetEpoch(false);
-    }
-
-    void AudioDriftController::ResetEpoch(const bool countReset) noexcept
-    {
-        observations_.clear();
-        lastDevicePositionFrames_ = 0;
-        lastQpcPosition100ns_ = 0;
-        persistentOutsideDeadband100ns_ = 0;
-        outsideConfirmedRange100ns_ = 0;
-        persistentSign_ = 0;
-        haveLastObservation_ = false;
-        diagnostics_.measuredPpm = 0.0;
-        diagnostics_.correctedPhaseFrames = 0.0;
-        diagnostics_.targetPpm = 0;
-        diagnostics_.requestedPpm = 0;
-        diagnostics_.observationWindowReady = false;
-        diagnostics_.correctionActive = false;
-        if (countReset)
-        {
-            ++diagnostics_.epochResets;
-        }
-    }
-
-    void AudioDriftController::Observe(
-        const std::uint64_t devicePositionFrames,
-        const std::int64_t qpcPosition100ns,
-        const std::int32_t appliedCorrectionPpm,
-        const bool discontinuity) noexcept
-    {
-        if (devicePositionFrequency_ == 0 || qpcPosition100ns <= 0)
-        {
-            ++diagnostics_.observationsRejected;
-            return;
-        }
-        if (discontinuity ||
-            (haveLastObservation_ &&
-                (devicePositionFrames < lastDevicePositionFrames_ ||
-                 qpcPosition100ns <= lastQpcPosition100ns_)))
-        {
-            ResetEpoch(true);
-        }
-
-        if (haveLastObservation_)
-        {
-            const auto deviceDelta = devicePositionFrames -
-                lastDevicePositionFrames_;
-            const auto qpcDelta = qpcPosition100ns - lastQpcPosition100ns_;
-            const auto correctionRatio = 1.0 +
-                static_cast<double>(appliedCorrectionPpm) / PpmScale;
-            const auto deviceToOutputRatio =
-                static_cast<double>(devicePositionFrequency_) /
-                AudioOutputSampleRate * correctionRatio;
-            if (qpcDelta > 0 && deviceToOutputRatio > 0.0)
-            {
-                const auto normalizedOutputFrames =
-                    static_cast<double>(deviceDelta) / deviceToOutputRatio;
-                const auto sessionFrames = static_cast<double>(qpcDelta) *
-                    AudioOutputSampleRate /
-                    AudioHundredNanosecondsPerSecond;
-                diagnostics_.correctedPhaseFrames +=
-                    normalizedOutputFrames - sessionFrames;
-            }
-        }
-
-        diagnostics_.lastAppliedPpm = appliedCorrectionPpm;
-        lastDevicePositionFrames_ = devicePositionFrames;
-        lastQpcPosition100ns_ = qpcPosition100ns;
-        haveLastObservation_ = true;
-        observations_.push_back(Observation{
-            devicePositionFrames,
-            qpcPosition100ns });
-        while (observations_.size() > 2 &&
-            observations_.back().qpcPosition100ns -
-                observations_[1].qpcPosition100ns >=
-                    AudioDriftObservation100ns)
-        {
-            observations_.pop_front();
-        }
-        ++diagnostics_.observationsAccepted;
-        UpdateMeasuredRate();
-    }
-
-    void AudioDriftController::UpdateMeasuredRate() noexcept
-    {
-        if (observations_.size() < 2 || devicePositionFrequency_ == 0)
-        {
-            diagnostics_.observationWindowReady = false;
-            return;
-        }
-        const auto& first = observations_.front();
-        const auto& last = observations_.back();
-        const auto qpcDelta = last.qpcPosition100ns -
-            first.qpcPosition100ns;
-        const auto deviceDelta = last.devicePositionFrames -
-            first.devicePositionFrames;
-        diagnostics_.observationWindowReady =
-            qpcDelta >= AudioDriftObservation100ns;
-        if (qpcDelta <= 0)
-        {
-            return;
-        }
-        const auto measuredRate = static_cast<double>(deviceDelta) *
-            AudioHundredNanosecondsPerSecond / qpcDelta;
-        diagnostics_.measuredPpm =
-            (measuredRate / devicePositionFrequency_ - 1.0) * PpmScale;
-    }
-
-    std::int32_t AudioDriftController::AdvanceOutputBlock() noexcept
-    {
-        if (diagnostics_.clockUnhealthy)
-        {
-            diagnostics_.requestedPpm = 0;
-            return 0;
-        }
-
-        const auto phase = diagnostics_.correctedPhaseFrames;
-        const auto sign = phase > DeadbandFrames
-            ? 1
-            : phase < -DeadbandFrames ? -1 : 0;
-        if (diagnostics_.observationWindowReady && sign != 0)
-        {
-            if (sign == persistentSign_)
-            {
-                persistentOutsideDeadband100ns_ += OutputBlockDuration100ns;
-            }
-            else
-            {
-                persistentSign_ = sign;
-                persistentOutsideDeadband100ns_ = OutputBlockDuration100ns;
-            }
-            if (persistentOutsideDeadband100ns_ >=
-                AudioDriftPersistence100ns)
-            {
-                diagnostics_.correctionActive = true;
-            }
-        }
-        else if (!diagnostics_.correctionActive)
-        {
-            persistentSign_ = 0;
-            persistentOutsideDeadband100ns_ = 0;
-        }
-
-        if (diagnostics_.observationWindowReady &&
-            std::abs(diagnostics_.measuredPpm) >
-                AudioMaximumRateCorrectionPpm)
-        {
-            outsideConfirmedRange100ns_ += OutputBlockDuration100ns;
-            if (outsideConfirmedRange100ns_ >=
-                AudioDriftObservation100ns * 2)
-            {
-                diagnostics_.clockUnhealthy = true;
-                diagnostics_.requestedPpm = 0;
-                return 0;
-            }
-        }
-        else
-        {
-            outsideConfirmedRange100ns_ = 0;
-        }
-
-        if (diagnostics_.correctionActive)
-        {
-            const auto phaseSeconds = phase / AudioOutputSampleRate;
-            const auto horizonSeconds =
-                static_cast<double>(AudioDriftCorrectionHorizon100ns) /
-                AudioHundredNanosecondsPerSecond;
-            const auto unclampedTarget = diagnostics_.measuredPpm +
-                phaseSeconds / horizonSeconds * PpmScale;
-            const auto clampedTarget = std::clamp(
-                unclampedTarget,
-                -static_cast<double>(AudioMaximumRateCorrectionPpm),
-                static_cast<double>(AudioMaximumRateCorrectionPpm));
-            if (clampedTarget != unclampedTarget)
-            {
-                ++diagnostics_.ratioClampCount;
-            }
-            diagnostics_.targetPpm = static_cast<std::int32_t>(
-                std::llround(clampedTarget));
-        }
-        else
-        {
-            diagnostics_.targetPpm = 0;
-        }
-
-        if (diagnostics_.requestedPpm < diagnostics_.targetPpm)
-        {
-            ++diagnostics_.requestedPpm;
-        }
-        else if (diagnostics_.requestedPpm > diagnostics_.targetPpm)
-        {
-            --diagnostics_.requestedPpm;
-        }
-        ++diagnostics_.correctionBlocks;
-        return diagnostics_.requestedPpm;
-    }
-
-    void AudioDriftController::MarkBufferPressure() noexcept
-    {
-        ++diagnostics_.bufferPressureCount;
-        if (diagnostics_.bufferPressureCount >= 2)
-        {
-            diagnostics_.clockUnhealthy = true;
-            diagnostics_.requestedPpm = 0;
-        }
-    }
-
-    std::int32_t AudioDriftController::RequestedPpm() const noexcept
-    {
-        return diagnostics_.requestedPpm;
-    }
-
-    bool AudioDriftController::ClockHealthy() const noexcept
-    {
-        return !diagnostics_.clockUnhealthy;
-    }
-
-    AudioDriftControllerDiagnostics
-    AudioDriftController::Diagnostics() const noexcept
-    {
-        return diagnostics_;
-    }
-}
