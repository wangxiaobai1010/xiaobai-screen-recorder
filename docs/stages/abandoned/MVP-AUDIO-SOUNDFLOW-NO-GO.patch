-internal sealed class SegmentedWaveFileWriter : IDisposable
-{
-    // A RIFF chunk length is uint32. Leave ample room for the RIFF/WAVE/fmt
-    // headers while preserving the capture format byte-for-byte.
-    internal const long DefaultMaximumDataBytes = uint.MaxValue - 1024L * 1024L;
-
-    private readonly string _directory;
-    private readonly WaveFormat _format;
-    private readonly long _maximumDataBytes;
-    private WaveFileWriter? _writer;
-    private long _segmentDataBytes;
-    private int _segmentIndex;
-    private bool _disposed;
-
-    internal SegmentedWaveFileWriter(
-        string directory,
-        WaveFormat format,
-        long maximumDataBytes = DefaultMaximumDataBytes)
-    {
-        ArgumentException.ThrowIfNullOrWhiteSpace(directory);
-        ArgumentNullException.ThrowIfNull(format);
-        if (!Path.IsPathFullyQualified(directory) ||
-            !Directory.Exists(directory))
-        {
-            throw new DirectoryNotFoundException(directory);
-        }
-        if (format.BlockAlign <= 0)
-        {
-            throw new ArgumentException(
-                "The microphone WaveFormat has no valid block alignment.",
-                nameof(format));
-        }
-
-        long bounded = Math.Min(maximumDataBytes, DefaultMaximumDataBytes);
-        bounded -= bounded % format.BlockAlign;
-        if (bounded < format.BlockAlign)
-        {
-            throw new ArgumentOutOfRangeException(nameof(maximumDataBytes));
-        }
-
-        _directory = directory;
-        _format = format;
-        _maximumDataBytes = bounded;
-        OpenNextSegment();
-    }
-
-    internal long TotalDataBytes { get; private set; }
-
-    internal IReadOnlyList<string> SegmentPaths => _segmentPaths;
-
-    private readonly List<string> _segmentPaths = [];
-
-    internal void Write(byte[] buffer, int offset, int count)
-    {
-        ObjectDisposedException.ThrowIf(_disposed, this);
-        ArgumentNullException.ThrowIfNull(buffer);
-        ArgumentOutOfRangeException.ThrowIfNegative(offset);
-        ArgumentOutOfRangeException.ThrowIfNegative(count);
-        if (offset > buffer.Length - count)
-        {
-            throw new ArgumentException("The microphone buffer range is invalid.");
-        }
-        if (count % _format.BlockAlign != 0)
-        {
-            throw new InvalidDataException(
-                "NAudio returned a microphone buffer that is not frame-aligned.");
-        }
-
-        while (count != 0)
-        {
-            long remaining = _maximumDataBytes - _segmentDataBytes;
-            if (remaining == 0)
-            {
-                OpenNextSegment();
-                remaining = _maximumDataBytes;
-            }
-            int writeCount = (int)Math.Min(count, Math.Min(remaining, int.MaxValue));
-            writeCount -= writeCount % _format.BlockAlign;
-            if (writeCount == 0)
-            {
-                OpenNextSegment();
-                continue;
-            }
-            _writer!.Write(buffer, offset, writeCount);
-            _segmentDataBytes += writeCount;
-            TotalDataBytes += writeCount;
-            offset += writeCount;
-            count -= writeCount;
-        }
-    }
-
-    public void Dispose()
-    {
-        if (_disposed)
-        {
-            return;
-        }
-        _disposed = true;
-        _writer?.Dispose();
-        _writer = null;
-    }
-
-    private void OpenNextSegment()
-    {
-        _writer?.Dispose();
-        _writer = null;
-        _segmentDataBytes = 0;
-        string path = Path.Combine(
-            _directory,
-            $"mic-{_segmentIndex:D4}.wav");
-        _segmentIndex = checked(_segmentIndex + 1);
-        _writer = new WaveFileWriter(path, _format);
-        _segmentPaths.Add(path);
-    }
-}
