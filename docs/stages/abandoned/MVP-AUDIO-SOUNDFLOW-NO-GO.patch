-    void RunAudioV2FinalizeIntegrationCore(
-        const std::filesystem::path& ffmpegPath,
-        const std::filesystem::path& videoPath,
-        const std::filesystem::path& systemFlacPath,
-        const std::filesystem::path& microphoneFlacPath,
-        const std::filesystem::path& outputDirectory,
-        const std::int64_t expectedDuration100ns,
-        const bool dualOnly)
-    {
-        Require(ffmpegPath.is_absolute() && videoPath.is_absolute() &&
-            systemFlacPath.is_absolute() && microphoneFlacPath.is_absolute() &&
-            outputDirectory.is_absolute() && expectedDuration100ns > 0,
-            "Audio V2 integration requires absolute paths and duration");
-        std::filesystem::create_directories(outputDirectory);
-
-        wchar_t original[32'768]{};
-        const auto originalLength = GetEnvironmentVariableW(
-            L"XB_AUDIO_V2_FFMPEG_PATH", original,
-            static_cast<DWORD>(std::size(original)));
-        Require(SetEnvironmentVariableW(
-            L"XB_AUDIO_V2_FFMPEG_PATH", ffmpegPath.c_str()) != FALSE,
-            "Audio V2 integration sets the audited FFmpeg path");
-        struct RestoreEnvironment final
-        {
-            wchar_t* value;
-            DWORD length;
-            ~RestoreEnvironment()
-            {
-                SetEnvironmentVariableW(
-                    L"XB_AUDIO_V2_FFMPEG_PATH",
-                    length > 0 && length < 32'768 ? value : nullptr);
-            }
-        } restore{ original, originalLength };
-
-        const auto run = [&](const AudioV2FinalizeMode mode,
-                             const wchar_t* const name)
-        {
-            AudioV2FinalizeRequest request{};
-            request.mode = mode;
-            request.videoPath = videoPath;
-            request.systemFlacPath = systemFlacPath;
-            request.microphoneFlacPath = microphoneFlacPath;
-            request.outputPath = outputDirectory / name;
-            request.expectedDuration100ns = expectedDuration100ns;
-            const auto result = FinalizeAudioV2(request);
-            Require(SUCCEEDED(result.hresult) && result.processStarted &&
-                result.exitCode == 0 && !result.timedOut && result.outputCreated &&
-                (mode == AudioV2FinalizeMode::SystemOnly ||
-                    (result.loudnormFirstPassCompleted &&
-                        result.microphoneLoudnorm.valid &&
-                        result.loudnormSecondPassConfigured ==
-                            result.microphoneLoudnorm.measurable)) &&
-                (mode != AudioV2FinalizeMode::Dual ||
-                    (result.dualMixLoudnormFirstPassCompleted &&
-                        result.dualMixLoudnorm.valid &&
-                        result.dualMixLoudnormSecondPassConfigured ==
-                            result.dualMixLoudnorm.measurable)) &&
-                result.validated && result.validation.nativeVideoH264 &&
-                result.validation.nativeAudioAac &&
-                result.validation.sampleRate == 48'000 &&
-                result.validation.channels == 2 &&
-                result.validation.saturatedSamples == 0 &&
-                result.validation.audioReachedEndOfStream &&
-                result.validation.videoDecoded,
-                "Audio V2 product finalizer creates a validated MP4");
-        };
-        if (!dualOnly)
-        {
-            run(AudioV2FinalizeMode::SystemOnly, L"system-only.mp4");
-            run(AudioV2FinalizeMode::MicrophoneOnly, L"mic-only.mp4");
-        }
-        run(AudioV2FinalizeMode::Dual, L"dual.mp4");
-
-        if (dualOnly) return;
-        AudioV2FinalizeRequest invalidDuration{};
-        invalidDuration.mode = AudioV2FinalizeMode::SystemOnly;
-        invalidDuration.videoPath = videoPath;
-        invalidDuration.systemFlacPath = systemFlacPath;
-        invalidDuration.microphoneFlacPath = microphoneFlacPath;
-        invalidDuration.outputPath = outputDirectory / L"validation-failure.mp4";
-        invalidDuration.expectedDuration100ns = expectedDuration100ns +
-            10 * AudioHundredNanosecondsPerSecond;
-        const auto validationFailure = FinalizeAudioV2(invalidDuration);
-        Require(FAILED(validationFailure.hresult) &&
-            validationFailure.outputCreated && !validationFailure.validated &&
-            std::filesystem::is_regular_file(videoPath) &&
-            std::filesystem::is_regular_file(systemFlacPath) &&
-            std::filesystem::is_regular_file(microphoneFlacPath),
-            "Audio V2 validation failure retains all source materials");
-    }
-    }
