-                        FrameToMediaTime100ns(state.windowFrames);
-                    state.anchorAbsoluteQpc100ns =
-                        state.programOriginQpc100ns +
-                        state.windowStartPts100ns;
-                    state.anchorPeak = peak;
-                    state.anchorSet = true;
-                    break;
-                }
-            }
-        }
-        if (state.anchorSet)
-        {
-            const auto observed = state.postConvert.sourceFramesObserved;
-            CopyTimedPcmLocked(
-                state.postConvert, interleavedPcm, frameCount,
-                packetQpc100ns - state.programOriginQpc100ns);
-            state.postConvert.sourceFramesObserved = observed;
-        }
-    }
-
-    void MicNoiseDiagnosticTapAppendAacInput(
-        const std::int16_t* const interleavedPcm,
-        const std::uint32_t frameCount,
-        const std::int64_t sampleTime100ns,
-        const std::int64_t sampleDuration100ns) noexcept
-    {
-        if (!state.enabled.load(std::memory_order_acquire) ||
-            interleavedPcm == nullptr || frameCount == 0 ||
-            sampleTime100ns < 0 || sampleDuration100ns <= 0)
-        {
-            return;
-        }
-        std::lock_guard lock(dataMutex);
-        ++state.aacWriterBlocksObserved;
-        if (!state.encoderBound)
-        {
-            state.writerFramesBeforeEncoderBinding += frameCount;
-        }
-        const auto expectedDuration = FrameToMediaTime100ns(frameCount);
-        const auto durationDelta = sampleDuration100ns - expectedDuration;
-        if (durationDelta < -1 || durationDelta > 1)
-        {
-            ++state.aacDurationMismatchCount;
-        }
-        CopyTimedPcmLocked(
-            state.aacWriterInput, interleavedPcm, frameCount,
-            sampleTime100ns);
-    }
-
-    void MicNoiseDiagnosticTapFlush() noexcept
-    {
-        std::lock_guard lifecycleLock(lifecycleMutex);
-        if (!state.enabled.exchange(false, std::memory_order_acq_rel))
-        {
-            return;
-        }
-        std::lock_guard dataLock(dataMutex);
-        state.flushed = true;
-        if (state.anchorSet)
-        {
-            state.postConvert.writeHResult = WriteWave(
-                JoinPath(state.directory, L"01-system-post-convert.wav"),
-                state.postConvert.pcm);
-            state.aacWriterInput.writeHResult = WriteWave(
-                JoinPath(
-                    state.directory,
-                    L"02-actual-aac-writer-input.wav"),
-                state.aacWriterInput.pcm);
-        }
-        WriteSummaryLocked();
-    }
-
-    void MicNoiseDiagnosticTapCompletePublishedMp4(
-        const wchar_t* const publishedPath) noexcept
-    {
-        try
-        {
-            std::lock_guard lifecycleLock(lifecycleMutex);
-            {
-                std::lock_guard dataLock(dataMutex);
-                if (!state.flushed || state.decodeCompleted)
-                {
-                    return;
-                }
-                state.publishedPath = publishedPath != nullptr
-                    ? publishedPath : L"";
-            }
-            MicNoiseDiagnosticMp4AudioFacts mp4Audio;
-            const auto decodeResult = DecodePublishedMp4(
-                publishedPath, mp4Audio, true);
-            std::lock_guard dataLock(dataMutex);
-            state.decodeHResult = decodeResult;
-            state.decodeCompleted = true;
-            state.mp4Audio = mp4Audio;
-            if (SUCCEEDED(decodeResult) && state.anchorSet)
-            {
-                state.mp4Decoded.writeHResult = WriteWave(
-                    JoinPath(state.directory, L"03-final-mp4-decoded.wav"),
-                    state.mp4Decoded.pcm);
-            }
-            WriteSummaryLocked();
-        }
-        catch (...)
-        {
-            // Published production output remains authoritative.
-        }
-    }
-
-    HRESULT MicNoiseDiagnosticInspectMp4Audio(
-        const wchar_t* const publishedPath,
-        MicNoiseDiagnosticMp4AudioFacts& facts) noexcept
-    {
-        return DecodePublishedMp4(publishedPath, facts, false);
-    }
-
-}
