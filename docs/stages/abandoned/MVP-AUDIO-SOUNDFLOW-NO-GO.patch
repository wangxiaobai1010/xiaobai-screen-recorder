diff --git a/XbPreview.Native.Tests/AudioProgramFinalizerTests.cpp b/XbPreview.Native.Tests/AudioProgramFinalizerTests.cpp
new file mode 100644
index 0000000..af84372
--- /dev/null
+++ b/XbPreview.Native.Tests/AudioProgramFinalizerTests.cpp
@@ -0,0 +1,112 @@
+#include "AudioProgramFinalizerTests.h"
+
+#include "AudioProgramFinalizer.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace xbpreview::tests
+{
+    namespace
+    {
+        void Require(const bool condition, const char* const message)
+        {
+            if (!condition) throw std::runtime_error(message);
+        }
+
+        bool Contains(
+            const std::vector<std::wstring>& arguments,
+            const std::wstring& value)
+        {
+            return std::find(arguments.begin(), arguments.end(), value) !=
+                arguments.end();
+        }
+
+        struct TemporaryFiles final
+        {
+            TemporaryFiles()
+            {
+                root = std::filesystem::temp_directory_path() /
+                    (L"xbpreview-program-finalizer-" +
+                        std::to_wstring(GetCurrentProcessId()) + L"-" +
+                        std::to_wstring(GetTickCount64()));
+                std::filesystem::create_directories(root);
+                video = root / L"video.mp4";
+                program = root / L"program.flac";
+                output = root / L"output.mp4";
+                std::ofstream(video, std::ios::binary).put('\0');
+                std::ofstream(program, std::ios::binary).put('\0');
+            }
+
+            ~TemporaryFiles()
+            {
+                std::error_code error;
+                std::filesystem::remove_all(root, error);
+            }
+
+            std::filesystem::path root;
+            std::filesystem::path video;
+            std::filesystem::path program;
+            std::filesystem::path output;
+        };
+    }
+
+    void RunAudioProgramFinalizerTests()
+    {
+        TemporaryFiles files;
+        ProgramFinalizeRequest request{};
+        request.videoPath = files.video;
+        request.programFlacPath = files.program;
+        request.outputPath = files.output;
+        request.expectedDuration100ns = 10'000'000;
+
+        const auto arguments = BuildProgramFfmpegArguments(request);
+        Require(
+            std::count(arguments.begin(), arguments.end(), L"-i") == 2,
+            "program finalizer accepts exactly video plus one program track");
+        Require(
+            Contains(arguments, L"0:v:0") && Contains(arguments, L"1:a:0") &&
+            Contains(arguments, L"copy") && Contains(arguments, L"aac") &&
+            Contains(arguments, L"192k") && Contains(arguments, L"48000") &&
+            Contains(arguments, L"2"),
+            "program finalizer stream-copies H.264 and encodes AAC 48 kHz stereo");
+
+        std::wstring joined;
+        for (const auto& argument : arguments)
+        {
+            joined += argument;
+            joined.push_back(L' ');
+        }
+        Require(
+            joined.find(L"filter") == std::wstring::npos &&
+            joined.find(L"mix") == std::wstring::npos &&
+            joined.find(L"gate") == std::wstring::npos &&
+            joined.find(L"loudnorm") == std::wstring::npos,
+            "FFmpeg is limited to AAC encoding and muxing");
+        Require(
+            ProgramFinalizeStorageSufficient(
+                512ull * 1024ull * 1024ull,
+                32ull * 1024ull * 1024ull) &&
+            !ProgramFinalizeStorageSufficient(1, 1) &&
+            !ProgramFinalizeStorageSufficient(1024, 0),
+            "program finalizer keeps bounded free-space admission");
+
+        request.programFlacPath = L"relative.flac";
+        bool rejected{};
+        try
+        {
+            (void)BuildProgramFfmpegArguments(request);
+        }
+        catch (const std::invalid_argument&)
+        {
+            rejected = true;
+        }
+        Require(rejected, "program finalizer rejects non-packaged relative inputs");
+    }
+}
