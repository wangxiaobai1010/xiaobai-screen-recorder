-        }
-        SetEnvironmentVariableW(
-            L"XB_PREVIEW_MIC_NOISE_DIAGNOSTIC_DIR", nullptr);
-        SetEnvironmentVariableW(
-            L"XB_PREVIEW_MIC_NOISE_DIAGNOSTIC_SECONDS", nullptr);
