-
-        const auto delta = positionFrames - anchorPositionFrames_;
-        const auto whole = delta / positionFrequency_;
-        const auto remainder = delta % positionFrequency_;
-        const auto maximum = static_cast<std::uint64_t>(
-            (std::numeric_limits<std::int64_t>::max)());
-        if (whole > maximum /
-                static_cast<std::uint64_t>(AudioHundredNanosecondsPerSecond))
